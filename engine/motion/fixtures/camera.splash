use mod.motion.*
Motion{
    size: vec2(1920, 1080) duration: 6 background: #10141b
    layers: [
        Camera{name: "push" span: [0, 3]
            center: tween(vec2(960, 540), vec2(1270, 410), 0.4, 2.5, @ease_in_out_cubic)
            zoom: tween(1, 2.5, 0.4, 2.5, @ease_in_out_cubic)
            roll: tween(0, 2, 0.4, 2.5, @ease_in_out_cubic)
            screen: vec2(960, 580) layers: [
                Plot{x: [-3.14159265, 3.14159265] y: [-1.5, 1.5]
                    at: vec2(340, 330) size: vec2(1240, 480) labels: false color: #657789 layers: [
                    Graph{f: fn(x) { sin(x) } color: #ff9a52 width: 4}
                    Dot{at: vec2(1.57079633, 1) radius: 7 color: #64dcbd}
                ]}
            ]}
        Plot{name: "sine" span: [3, 3] x: [-3.14159265, 3.14159265] y: [-1.5, 1.5]
            at: vec2(180, 340) size: vec2(840, 480) labels: false color: #657789 layers: [
            Graph{name: "wave" f: fn(x) { sin(x) } color: #ff9a52 width: 4}
            Dot{at: vec2(1.57079633, 1) radius: 7 color: #64dcbd}
        ]}
        Zoomed{name: "detail" of: "sine" region: [680, 370, 250, 180]
            at: vec2(1240, 350) size: vec2(480, 360)
            frame: #f2efe6 width: 2 connect: true background: #10141b radius: 0
            opacity: tween(0, 1, 3, 3.4)}
        Text{text: "Follow a feature" span: [0, 3] at: vec2(180, 80) size: 52 color: #f2efe6}
        Text{text: "Keep context, magnify a detail" span: [3, 3] at: vec2(180, 80) size: 52 color: #f2efe6}
        Text{text: "The crest, enlarged" span: [3, 3] at: vec2(1240, 240) size: 30 color: #f2efe6}
        Text{text: "One world. A closer look." span: [3, 3] at: vec2(180, 940) size: 30 color: #a8b8c8}
    ]
}
