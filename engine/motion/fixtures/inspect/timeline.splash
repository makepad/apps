use mod.motion.*
Motion{size: vec2(640, 480) duration: 4.0 fps: 20 layers: [
    Text{name: "gapped" text: "H" size: 24 at: vec2(80, 60)
        opacity: keys([0.0, 1], [1.0, 0, @hold], [2.0, 1, @hold], [3.0, 0, @hold])}
    Text{name: "continuous" text: "H" size: 24 at: vec2(80, 120)}
    Text{name: "hidden" text: "H" size: 24 opacity: 0 at: vec2(80, 180)}
    Group{name: "late parent" span: [0.7, 2.0] layers: [
        Text{name: "brief child" text: "H" size: 24 at: vec2(80, 240) span: [0.35, 0.04]}
    ]}
    Rect{name: "transparent" size: vec2(100, 100) fill: #fff0}
    Text{name: "outside" text: "H" size: 24 at: vec2(800, 120)}
]}
