use mod.motion.*
// The P(DOOM) lyric film's own kit: its odometer, engineering diagrams drawn on, its post chain and the detector HUD box.
//
//   use mod.motion.modules.film.*
//   Motion{color: @hdr post: film_post({bloom: 0.7}) layers: [
//       odometer({value: fn(t) { prog(t, 1.0, 2.0) * 0.15 } decimals: 2 at: vec2(92, 250) size: 540
//           font: Font{family: "JetBrains Mono" weight: 400} color: #ff4d12 extra: nil digit: "9"})
//       diagram(Diagram{boxes: [DBox{id: "enc" at: vec2(200, 300) size: vec2(260, 120) label: "ENCODER"}]})
//       detect_box({geo: fn(t) { vec4(960, 540, 120, 90) } label: "EYE  0.97" t0: 1.2 close: -1 sub: nil})
//   ]}

let wrap10 = mod.forms.wrap10
let drum_pos = mod.forms.drum_pos
/** A mechanical number in a monospace face: `0.` and `decimals` wheels rolling to
 *  `value(t)` (0..1), each wheel showing its digit and neighbours fading off its
 *  window. `extra(t)` (or nil) appends that many `digit`s, a string that grows.
 *  `odometer({value: fn(t) { … } decimals: 2 at: vec2(92, 250) size: 540
 *  font: Font{family: "JetBrains Mono" weight: 400} color: #ff4d12 extra: nil digit: "9"})`. */
let odometer = fn(o) {
    let em = o.size * 4.0 / 3.0
    let adv = em * 0.6
    let row = em * 1.05
    let out = [Text{text: "0." font: o.font size: o.size at: o.at color: o.color}]
    for d in 0..o.decimals {
        let k = o.decimals - 1 - d
        let pos = fn(t) { drum_pos(o.value(t) * pow(10.0, o.decimals), k) }
        for j in -1..2 {
            out.push(Text{number: fn(t) { wrap10(floor(pos(t)) + j) } decimals: 0 font: o.font size: o.size
                at: o.at + vec2(adv * (2 + d), 0) color: o.color
                y: fn(t) { (j - fract(pos(t))) * row }
                opacity: fn(t) { max(0.0, 1.0 - abs((fract(pos(t)) - j) * row) / (row * 0.85)) }})
        }
    }
    if o.extra != nil {
        for e in 0..30 {
            out.push(Text{text: o.digit font: o.font size: o.size at: o.at + vec2(adv * (2 + o.decimals + e), 0) color: o.color
                opacity: fn(t) { if o.extra(t) > e { 1.0 } else { 0.0 } }})
        }
    }
    return Group{name: "odometer" layers: out}
}
/** An engineering diagram drawn on (PDOOM-PARITY K12): corner-bracketed boxes with
 *  mono labels, arrows routed between them (`route: @ortho` elbows or `@straight`) with
 *  arrowheads and labels, and dimension lines with end ticks, drawing on in order from
 *  `start`, `stagger` apart. Coordinates are the document's. The parts are prototypes, so
 *  only what differs is written:
 *  `diagram(Diagram{boxes: [DBox{id: "enc" at: vec2(200, 300) size: vec2(260, 120) label: "ENCODER"}]
 *  arrows: [DArrow{from: "enc" to: "dec" label: "z"}] dims: [DDim{a: vec2(200, 460) b: vec2(460, 460) label: "260"}]
 *  start: 0.3})`. Diagram's own fields: color, accent, width, font, label_size, start, stagger,
 *  dur, bracket (corner length as a share of the side; 0 draws the whole outline). */
let Diagram = {color: #f2efe6 accent: #ff4d12 width: 2 font: Font{family: "JetBrains Mono"} label_size: 26 start: 0.2 stagger: 0.15
    dur: 0.6 bracket: 0.22 boxes: [] arrows: [] dims: []}
let DBox = {id: "" at: vec2(0, 0) size: vec2(200, 100) label: nil}
let DArrow = {from: "" to: "" label: nil route: @ortho}
let DDim = {a: vec2(0, 0) b: vec2(100, 0) label: nil}
let dia_on = fn(t0, dur) { return tween(0, 1, t0, t0 + dur, @ease_in_out_cubic) }
let dia_fade = fn(t0) { return tween(0, 1, t0, t0 + 0.25, @ease_out) }
/** The point on box `b`'s edge facing `p`. */
let dia_edge = fn(b, p) {
    let c = b.at + b.size * 0.5
    let d = p - c
    if abs(d.x) * b.size.y > abs(d.y) * b.size.x {
        return vec2(c.x + sign(d.x) * b.size.x * 0.5, c.y)
    }
    return vec2(c.x, c.y + sign(d.y) * b.size.y * 0.5)
}
let diagram = fn(p) {
    let color = p.color
    let accent = p.accent
    let width = p.width
    let font = p.font
    let ls = p.label_size
    let ls_arrow = ls * 0.8
    let ls_dim = ls * 0.7
    let start = p.start
    let stagger = p.stagger
    let dur = p.dur
    let bracket = p.bracket
    let boxes = p.boxes
    let arrows = p.arrows
    let dims = p.dims
    let out = []
    var k = 0
    for b in boxes {
        let t0 = start + k * stagger
        let a = b.at
        let s = b.size
        if bracket <= 0.0 {
            out.push(Rect{at: a size: s stroke: color width: width trim_end: dia_on(t0, dur)})
        } else {
            let cx = s.x * bracket
            let cy = s.y * bracket
            out.push(Path{points: [a + vec2(0, cy), a, a + vec2(cx, 0)] stroke: color width: width trim_end: dia_on(t0, dur)})
            out.push(Path{points: [a + vec2(s.x - cx, 0), a + vec2(s.x, 0), a + vec2(s.x, cy)] stroke: color width: width trim_end: dia_on(t0, dur)})
            out.push(Path{points: [a + vec2(s.x, s.y - cy), a + s, a + vec2(s.x - cx, s.y)] stroke: color width: width trim_end: dia_on(t0, dur)})
            out.push(Path{points: [a + vec2(cx, s.y), a + vec2(0, s.y), a + vec2(0, s.y - cy)] stroke: color width: width trim_end: dia_on(t0, dur)})
        }
        if b.label != nil {
            out.push(Text{text: b.label font: font{weight: 500} size: ls color: color align: @center
                at: a + vec2(s.x * 0.5, s.y * 0.5 - ls * 0.7) opacity: dia_fade(t0 + dur * 0.5)})
        }
        k = k + 1
    }
    for r in arrows {
        let t0 = start + k * stagger
        var fb = nil
        var tb = nil
        for b in boxes {
            if b.id == r.from { fb = b }
            if b.id == r.to { tb = b }
        }
        if fb != nil && tb != nil {
            let s = dia_edge(fb, tb.at + tb.size * 0.5)
            let e = dia_edge(tb, fb.at + fb.size * 0.5)
            var pts = [s, e]
            if r.route != @straight {
                // Leave along the side's normal: a side exit runs across
                // first, a top or bottom exit runs up or down first.
                let fc = fb.at + fb.size * 0.5
                if abs(s.x - fc.x) > 0.01 {
                    let mx = (s.x + e.x) * 0.5
                    pts = [s, vec2(mx, s.y), vec2(mx, e.y), e]
                } else {
                    let my = (s.y + e.y) * 0.5
                    pts = [s, vec2(s.x, my), vec2(e.x, my), e]
                }
            }
            out.push(Path{points: pts stroke: accent width: width trim_end: dia_on(t0, dur)})
            let prev = pts[pts.len() - 2]
            let d = (e - prev) / max(length(e - prev), 0.001)
            let n = vec2(0.0 - d.y, d.x)
            let h = 6.0 + width * 3.0
            out.push(Path{points: [e - d * h + n * h * 0.5, e, e - d * h - n * h * 0.5] stroke: accent width: width opacity: dia_fade(t0 + dur)})
            if r.label != nil {
                let m = (s + e) * 0.5
                out.push(Text{text: r.label font: font{weight: 500} size: ls_arrow color: accent align: @center
                    at: m + vec2(0, 0.0 - ls_arrow * 1.5) opacity: dia_fade(t0 + dur * 0.7)})
            }
        }
        k = k + 1
    }
    for m in dims {
        let t0 = start + k * stagger
        let d = (m.b - m.a) / max(length(m.b - m.a), 0.001)
        let n = vec2(0.0 - d.y, d.x) * 8.0
        out.push(Path{points: [m.a, m.b] stroke: color width: 1 trim_end: dia_on(t0, dur)})
        out.push(Path{points: [m.a - n, m.a + n] stroke: color width: 1 opacity: dia_fade(t0)})
        out.push(Path{points: [m.b - n, m.b + n] stroke: color width: 1 opacity: dia_fade(t0 + dur)})
        if m.label != nil {
            out.push(Text{text: m.label font: font{weight: 400} size: ls_dim color: color align: @center
                at: (m.a + m.b) * 0.5 + vec2(0, 6) opacity: dia_fade(t0 + dur * 0.6)})
        }
        k = k + 1
    }
    return Group{name: "diagram" layers: out}
}
/** A film's post chain (the reference lyric film's post.ts): chromatic aberration, bloom with
 *  halation, the tone shoulder, lens vignette and two-scale grain, with its defaults:
 *  `post: film_post({})`, or override any of `{bloom threshold knee radius halation ca vignette
 *  grain}` (numbers or `fn(t)`). Frame moves and flashes ride along when given:
 *  `zoom` (1 = none, a punch-in on hits) and `shake` (a vec2 offset in document units; `size` the
 *  document's, default 1920 x 1080) move the frame before everything; `flash` (0..1+) adds `flash_color` (an sRGB colour, default white) after the
 *  shoulder; `fade` (0..1) fades to black after the vignette. The document needs
 *  `color: @hdr`; add `motion_blur: MotionBlur{shutter: 72 samples: 108}` for export.
 *  `post: film_post({ca: fn(t) { 1.2 + 4.0 * hit(t) } shake: fn(t) { cam2d_shake(t, 6.0 * hit(t), 40.0, 1.0) }
 *  flash: fn(t) { pulse(t, 3.2, 0.1) } flash_color: #eee9df})` */
let film_post = fn(o) {
    let out = []
    if (o.shake ?? nil) != nil || (o.zoom ?? nil) != nil {
        out.push(mod.post.Pass{at: @hdr reads: [@color]
            uniforms: {zoom: o.zoom ?? 1.0 shake: o.shake ?? fn(t) { vec2(0.0, 0.0) } doc: fn(t) { o.size ?? vec2(1920.0, 1080.0) }}
            pixel: fn() -> vec4 {
                let res = self.doc
                let uv = (self.uv() - vec2(0.5, 0.5)) / self.zoom + vec2(0.5, 0.5) - vec2(self.shake.x / res.x, -self.shake.y / res.y)
                return self.color.sample(uv)
            }})
    }
    out.push(mod.post.Aberration{falloff: 2 amount: o.ca ?? 1.2})
    out.push(mod.post.Bloom{strength: o.bloom ?? 0.55 threshold: o.threshold ?? 0.85 knee: o.knee ?? 0.5 radius: o.radius ?? 0.75 halation: o.halation ?? 0.25})
    out.push(mod.post.Shoulder{})
    if (o.flash ?? nil) != nil {
        // (a vector uniform is a fn(t), so its width is known)
        let light = mod.shared.linear_rgb(o.flash_color ?? #ffffff)
        out.push(mod.post.Pass{at: @hdr reads: [@color]
            uniforms: {flash: o.flash flash_color: fn(t) { light }}
            pixel: fn() -> vec4 {
                let c = self.color.sample(self.uv())
                return vec4(c.xyz + self.flash_color * self.flash, c.w)
            }})
    }
    out.push(mod.post.Vignette{mode: 1 amount: o.vignette ?? 0.35})
    if (o.fade ?? nil) != nil {
        out.push(mod.post.Pass{at: @hdr reads: [@color] uniforms: {fade: o.fade}
            pixel: fn() -> vec4 {
                let c = self.color.sample(self.uv())
                return vec4(c.xyz * (1.0 - self.fade), c.w)
            }})
    }
    out.push(mod.post.Grain{amount: o.grain ?? 0.055})
    return out
}
/** An ML-detector box that follows something (the reference's shoggoth HUD): corner
 *  brackets, a faint outline, a signal tag with the label, a mono sub-line. It pops in at
 *  `t0` (1.35 -> 1 over 0.16 s, ease out expo; alpha over 0.05 s; frame-keyed flicker for
 *  0.12 s) and, with `close` > 0, shrinks away over 0.18 s from `close`. `geo: fn(t)`
 *  gives vec4(cx, cy, half width, half height) in document units (for a Scene3D node:
 *  from `project`-style maths or `anchor(...)`). `sub` is a string, or nil.
 *  `detect_box({geo: fn(t) { vec4(960, 540, 120, 90) } label: "EYE  0.97" t0: 1.2
 *  close: -1 sub: "t-00:02.45"})`; `big: true` drops the outline and dims the brackets,
 *  `frame: true` draws short frame corners and a larger tag. */
let detect_box = fn(o) {
    let big = (o.big ?? false) == true
    let frame = (o.frame ?? false) == true
    let close = o.close ?? -1.0
    let lw = if frame { 1.5 } else { 1.2 }
    let st = fn(t) {
        let age = t - o.t0
        var s = 1.35 + (1.0 - 1.35) * (1.0 - pow(2.0, 0.0 - 10.0 * clamp(age / 0.16, 0.0, 1.0)))
        var a = clamp(age / 0.05, 0.0, 1.0)
        if age < 0.12 { if mod.forms.hash01(mod.forms.frame_idx(t), 7.0) < 0.35 { a = a * 0.3 } }
        if close > 0.0 && t > close { let k = clamp((t - close) / 0.18, 0.0, 1.0) s = s * (1.0 - k * k * k * 0.9) a = a * (1.0 - k) }
        if age < 0.0 { a = 0.0 }
        return vec2(s, a)
    }
    let corner_l = fn(t) { let g = o.geo(t) return min(g.z, g.w) * st(t).x * (if frame { 0.12 } else { 0.34 }) }
    let out = []
    for c in [vec2(-1.0, -1.0), vec2(1.0, -1.0), vec2(-1.0, 1.0), vec2(1.0, 1.0)] {
        // the corner point, then a stroke along x and one along y, inwards
        let p = fn(t) { let g = o.geo(t) let s = st(t).x return vec2(g.x + c.x * g.z * s, g.y + c.y * g.w * s) }
        out.push(Rect{at: fn(t) { let q = p(t) let l = corner_l(t) vec2(if c.x < 0.0 { q.x } else { q.x - l }, q.y - lw / 2.0) }
            size: fn(t) { vec2(corner_l(t), lw) } fill: #eee9df opacity: if big { 0.55 } else { 0.85 }})
        out.push(Rect{at: fn(t) { let q = p(t) let l = corner_l(t) vec2(q.x - lw / 2.0, if c.y < 0.0 { q.y } else { q.y - l }) }
            size: fn(t) { vec2(lw, corner_l(t)) } fill: #eee9df opacity: if big { 0.55 } else { 0.85 }})
    }
    if !big && !frame {
        out.push(Rect{at: fn(t) { let g = o.geo(t) let s = st(t).x vec2(g.x - g.z * s, g.y - g.w * s) }
            size: fn(t) { let g = o.geo(t) let s = st(t).x vec2(2.0 * g.z * s, 2.0 * g.w * s) } stroke: #eee9df width: 1.2 opacity: 0.18})
    }
    let fs = if frame { 15.0 } else { 12.0 }
    let th = if frame { 22.0 } else { 18.0 }
    out.push(Text{text: o.label font: Font{family: "JetBrains Mono" weight: 700} size: fs * 0.75 tracking: 1 color: #0a0a0b plate: #ff4d12 plate_pad: 3 opacity: 0.95
        at: fn(t) { let g = o.geo(t) let s = st(t).x vec2(g.x - g.z * s + 6.0, g.y - g.w * s - th + th - (if frame { 6.0 } else { 5.0 }) - fs * 1.0125) }})
    if (o.sub ?? nil) != nil {
        let sfs = if frame { 14.0 } else { 11.0 }
        out.push(Text{text: o.sub font: Font{family: "JetBrains Mono"} size: sfs * 0.75 color: #eee9df opacity: 0.85
            at: fn(t) { let g = o.geo(t) let s = st(t).x vec2(g.x - g.z * s + 1.0, (if frame { g.y - g.w * s + 22.0 } else { g.y + g.w * s + 15.0 }) - sfs * 1.0125) }})
    }
    return Group{name: "detect_box" opacity: fn(t) { st(t).y } layers: out}
}

{odometer: odometer Diagram: Diagram DBox: DBox DArrow: DArrow DDim: DDim diagram: diagram film_post: film_post detect_box: detect_box}
