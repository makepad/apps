use mod.motion.*
// Numbers that move like instruments: value noise in 1, 2 and 3D, and a stepped value that rolls to each new step and creeps toward the next.
//
// Noise is seeded value noise in -1..1 on hashn's integer lattice, blended by the quintic fade:
// noise1(x, seed), vnoise(x, y, seed) (2D, built in), noise3(x, y, z, seed). `x` advances ~1 per
// feature; a different `seed` is an unrelated field. For gradient noise in 2D: snoise2(vec2).
//
//   use mod.motion.modules.numbers.*
//   let RISK = [[-1.0, 0.02], [23.9, 0.15], [60.1, 0.42]]          // [time, value] steps, first one before 0
//   Text{text: fn(t) { fixed(stepped_value(RISK, t, {}), 2) } font: Font{family: "JetBrains Mono"} size: 120}

// The quintic fade 6t^5 - 15t^4 + 10t^3: 0 -> 1 over 0..1 with flat ends (smoother than smoothstep).
let fade = fn(t) { return t * t * t * (t * (t * 6.0 - 15.0) + 10.0) }
// Smooth noise of one variable in -1..1: wobble, drift, tremor. `x` advances ~1 per feature
// (x = t * 3 for three wiggles a second); `seed` picks another curve.
let noise1 = fn(x, seed) {
    let i = floor(x)
    let a = hashn(i, seed) * 2.0 - 1.0
    let b = hashn(i + 1.0, seed) * 2.0 - 1.0
    return a + (b - a) * fade(x - i)
}
// Smooth noise of three variables in -1..1: vnoise planes at the integer z, shifted apart and
// faded between (a 2D field that changes over time: noise3(x, y, t * 24, seed) boils 24 times a second).
let noise3 = fn(x, y, z, seed) {
    let iz = floor(z)
    let a = vnoise(x + iz * 17.13, y - iz * 31.7, seed)
    let b = vnoise(x + (iz + 1.0) * 17.13, y - (iz + 1.0) * 31.7, seed)
    return a + (b - a) * fade(z - iz)
}
// A value that steps: `steps` [[t, v], …] in time order (the first holds before everything). At
// each step it rolls from the previous value over `roll` s (ease out expo; 0.2..2), then creeps
// `creep` (0..0.5) of the way to the next value before it lands, with `jitter` (0..0.02) of
// noise at `jitter_rate` Hz (`seed` picks the noise). Clamped to 0..1 unless `clamp: false`.
let unit01 = fn(x) { if x < 0.0 { return 0.0 } if x > 1.0 { return 1.0 } return x }
let stepped_value = fn(steps, t, o) {
    let n = steps.len()
    var i = 0
    while i + 1 < n && steps[i + 1][0] <= t { i = i + 1 }
    let cur = steps[i]
    let prev = steps[max(0, i - 1)]
    let u = unit01((t - cur[0]) / (o.roll ?? 0.9))
    let k = if i == 0 { 1.0 } else { if u >= 1.0 { 1.0 } else { 1.0 - pow(2.0, -10.0 * u) } }
    let base = prev[1] + (cur[1] - prev[1]) * k
    var creep = 0.0
    if i + 1 < n {
        let next = steps[i + 1]
        let w = unit01((t - (cur[0] + 1.0)) / (next[0] - (cur[0] + 1.0)))
        creep = (next[1] - cur[1]) * (o.creep ?? 0.2) * (w * w * (3.0 - 2.0 * w))
    }
    let jitter = noise1(t * (o.jitter_rate ?? 3.1), o.seed ?? 7.0) * (o.jitter ?? 0.004) * (1.0 - k * 0.5)
    let v = base + creep + jitter
    return if (o.clamp ?? true) { unit01(v) } else { v }
}

{fade: fade noise1: noise1 noise3: noise3 stepped_value: stepped_value}
