use mod.motion.*
// Print-shop marks for Draw2D layers: crop marks at a sheet's corners.
//
//   use mod.motion.modules.print.*
//   Draw2D{draw: fn(c, t, edit) { crop_marks(c, {inset: mix(36, -40, ease(@ease_in_cubic, prog(t, 8.0, 8.4)))}) }}

// Four corner marks, `inset` px from each edge (animate it to fly them out), arms `length` px,
// lines `width` px in `color` at `alpha` (0..1); `w h` the sheet (default 1920 x 1080).
let crop_marks = fn(c, o) {
    let m = o.inset ?? 36.0
    let l = o.length ?? 22.0
    let w = o.w ?? 1920.0
    let h = o.h ?? 1080.0
    for q in [[m, m, 1.0, 1.0], [w - m, m, -1.0, 1.0], [m, h - m, 1.0, -1.0], [w - m, h - m, -1.0, -1.0]] {
        c.stroke([[q[0] + q[2] * l, q[1] + 0.5 * q[3]], [q[0], q[1] + 0.5 * q[3]], [q[0], q[1] + q[3] * l]], o.width ?? 1.25, o.color ?? #eee9df, o.alpha ?? 0.34)
    }
}

{crop_marks: crop_marks}
