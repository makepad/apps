        Rect{name: "hairline" at: vec2(k.m, k.m + 12 * k.s) size: vec2(k.w - k.m * 2, 1) fill: k.ink anchor: vec2(0, 0.5) scale: tween(vec2(0, 1), vec2(1, 1), 0.15, 1.35, @ease_in_out_cubic)}
