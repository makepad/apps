        Text{name: "issue" text: "No. 07" font: Font{family: "Playfair Display" italic: true} size: 24 * k.s color: k.accent align: @right at: vec2(k.w - k.m, k.m - 30 * k.s) opacity: tween(0, 1, 0.5, 1.1)}
        Text{name: "folio" text: "— 12 —" font: Font{family: "Playfair Display"} size: 20 * k.s color: k.muted align: @center at: vec2(k.cx, k.h - k.m + 36 * k.s) opacity: tween(0, 1, 0.6, 1.2)}
    ] }
    screen: fn(k) { [] }
    post: [
