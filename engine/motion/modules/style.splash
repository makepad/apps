    look: "Bauhaus: cream stock, a red circle, blue square and yellow triangle springing in, a black bar, geometric sans"
    suits: "art and design, architecture, education, bold explainers"
    palette: {bg: #xefe7d6 ink: #x161616 accent: #xd42a1c accent2: #x1d4f9e muted: #xf1b400}
    display: {font: Font{family: "Roboto Flex" weight: 900} tracking: -0.02}
    body: {font: Font{family: "Inter" weight: 500} tracking: 0}
    upper: false
    label: Font{family: "JetBrains Mono"}
    leading: 0.95
    animate: @pop
    body_animate: @wipe
    speed: 1.0
    text3d: "slab_stack"
    kinetic: "405_letter_snap"
    fx: ""
    plate: fn(k) { [
        Rect{name: "paper" size: vec2(k.w, k.h) fill: k.bg}
        Ellipse{name: "red circle" at: vec2(k.w - k.u * 0.62, k.h * 0.08) size: vec2(k.u * 0.5, k.u * 0.5) fill: k.accent scale: tween(0, 1, 0.0, 0.6, @ease_out_back)}
        Rect{name: "blue square" at: vec2(k.w - k.u * 0.36, k.h * 0.46) size: vec2(k.u * 0.3, k.u * 0.3) fill: k.accent2 rotate: tween(-90, 0, 0.12, 0.8, @ease_out_back) scale: tween(0, 1, 0.12, 0.7, @ease_out_back)}
        Path{name: "yellow triangle" svg: "M 0 300 L 170 0 L 340 300 Z" fill: k.muted at: vec2(k.w - k.u * 0.74, k.h * 0.6) scale: tween(0, k.s, 0.24, 0.9, @ease_out_back)}
        Rect{name: "black bar" at: vec2(k.m, k.h - k.m - 18 * k.s) size: vec2(k.w * 0.4, 18 * k.s) fill: k.ink anchor: vec2(0, 0.5) scale: tween(vec2(0, 1), vec2(1, 1), 0.3, 0.9, @ease_out_expo)}
    ] }
    ornaments: fn(k) { [Ellipse{name: "dot" at: vec2(k.m, k.m) size: vec2(34 * k.s, 34 * k.s) fill: k.ink scale: tween(0, 1, 0.4, 0.8, @ease_out_back)}] }
    screen: fn(k) { [] }
    post: [Effect{name: @grain amount: 0.035 size: 1.3}]
    text_effects: []
}

let terminal = {
    look: "Data terminal: black CRT, phosphor-green mono typed on, a grid, corner brackets, a blinking REC status, a live level meter, scanlines and glow"
    suits: "tech, security, data, dev tools, hacker stories"
    palette: {bg: #x040a05 ink: #x3dff6e accent: #xc8ff3d accent2: #x19c8ff muted: #x0f3d1b}
    display: {font: Font{family: "JetBrains Mono" weight: 700} tracking: 0.02}
    body: {font: Font{family: "JetBrains Mono" weight: 400} tracking: 0}
    upper: true
    label: Font{family: "JetBrains Mono"}
    leading: 0.95
    animate: @typewriter
    body_animate: @typewriter
    speed: 1.4
    text3d: "counter_roll"
    kinetic: "351_matrix_rain"
    fx: "vjfx/351_matrix_rain"
    plate: fn(k) { [
        Rect{name: "screen" size: vec2(k.w, k.h) fill: k.bg}
        Pattern{name: "grid" kind: @grid color: k.muted cell: k.u * 0.05 weight: 0.05 size: vec2(k.w, k.h) opacity: 0.8}
    ] }
    ornaments: fn(k) { [
        Path{name: "bracket tl" svg: "M 0 60 L 0 0 L 60 0" stroke: k.ink width: 4 at: vec2(k.m, k.m) scale: k.s}
        Path{name: "bracket tr" svg: "M -60 0 L 0 0 L 0 60" stroke: k.ink width: 4 at: vec2(k.w - k.m, k.m) scale: k.s}
        Path{name: "bracket bl" svg: "M 0 -60 L 0 0 L 60 0" stroke: k.ink width: 4 at: vec2(k.m, k.h - k.m) scale: k.s}
        Path{name: "bracket br" svg: "M -60 0 L 0 0 L 0 -60" stroke: k.ink width: 4 at: vec2(k.w - k.m, k.h - k.m) scale: k.s}
        Text{name: "status" text: "● REC   SYS/OK" font: Font{family: "JetBrains Mono"} size: 20 * k.s color: k.accent align: @right at: vec2(k.w - k.m - 20 * k.s, k.m + 40 * k.s) opacity: repeat(keys([0, 1], [0.6, 0.25, @hold]), 1.2, @restart)}
        Repeat{name: "meter" count: 12 layout: @grid columns: 12 spacing: vec2(14 * k.s, 0) at: vec2(k.m + 20 * k.s, k.h - k.m - 80 * k.s) delay: 0.07
            layer: Rect{size: vec2(8 * k.s, 60 * k.s) fill: k.ink anchor: vec2(0.5, 1) scale: repeat(keys([0, vec2(1, 0.3)], [0.4, vec2(1, 1), @ease_out_cubic], [0.8, vec2(1, 0.3), @ease_in_cubic]), 0.8, @restart)}}
    ] }
    screen: fn(k) { [Pattern{name: "style.screen scanlines" kind: @stripes color: #x000000 cell: 4 weight: 0.45 angle: 90 size: vec2(k.w, k.h) opacity: 0.35}] }
    post: [
        Effect{name: @glow threshold: 0.4 radius: 14 intensity: 0.9}
        Effect{name: @chromatic_aberration amount: 1.2}
        Effect{name: @vignette amount: 0.6 feather: 0.6}
        Effect{name: @grain amount: 0.05 size: 1.2}
    ]
    text_effects: []
}

let luxury = {
    look: "Luxury minimal: warm black, a slow pool of light, one gold hairline and a diamond, widely tracked Garamond caps closing in slowly"
    suits: "fashion, jewellery, hotels, perfume, premium launches"
    palette: {bg: #x0d0c0a ink: #xefe7d4 accent: #xc9a86a accent2: #x6f6048 muted: #x26231e}
    display: {font: Font{family: "Cormorant Garamond" weight: 400} tracking: 0.2}
    body: {font: Font{family: "Inter" weight: 400} tracking: 0.04}
    upper: true
    label: Font{family: "Inter"}
    leading: 0.95
    animate: @tracking
    body_animate: @fade_up
    speed: 0.6
    text3d: "gold_foil"
    kinetic: "373_gold_ogee"
    fx: ""
    plate: fn(k) { [
        Rect{name: "black" size: vec2(k.w, k.h) fill: k.bg}
        Ellipse{name: "light" at: vec2(k.cx - k.w * 0.5, k.cy - k.u * 0.7) size: vec2(k.w, k.u * 1.4) fill: k.accent2 blur: k.u * 0.2 opacity: 0.22}
        Rect{name: "gold line" at: vec2(k.cx - k.w * 0.15, k.h * 0.88) size: vec2(k.w * 0.3, 1.5) fill: k.accent scale: tween(vec2(0, 1), vec2(1, 1), 0.4, 2.0, @ease_in_out_cubic)}
    ] }
    ornaments: fn(k) { [Path{name: "diamond" svg: "M 0 -9 L 9 0 L 0 9 L -9 0 Z" fill: k.accent at: vec2(k.cx, k.h * 0.88) scale: tween(0, k.s, 1.6, 2.2, @ease_out_back)}] }
    screen: fn(k) { [] }
    post: [
        Effect{name: @halation threshold: 0.7 radius: 10 amount: 0.4}
        Effect{name: @vignette amount: 0.45 feather: 0.6}
        Effect{name: @grain amount: 0.03 size: 1.1}
    ]
    text_effects: []
}

let ink_wash = {
    look: "Ink and watercolour: warm paper, indigo and vermilion washes blooming with dark pigment edges, an ink circle drawing itself, a brush-stroke underline, brush lettering"
    suits: "stories, poetry, food, travel, handmade brands, calm explainers"
    palette: {bg: #xf4efe4 ink: #x1b1b1b accent: #x3d7bb8 accent2: #xd9594c muted: #xc9bfa9}
    display: {font: Font{family: "LXGW WenKai" weight: 700} tracking: 0}
    body: {font: Font{family: "IBM Plex Sans" weight: 400} tracking: 0}
    upper: false
    label: Font{family: "JetBrains Mono"}
    leading: 1.0
    animate: @wipe
    body_animate: @fade_up
    speed: 0.9
    text3d: "clay"
    kinetic: "381_karaoke_ink"
    fx: ""
    plate: fn(k) { [
        Rect{name: "paper" size: vec2(k.w, k.h) fill: k.bg}
        Group{name: "blue wash" size: vec2(k.w, k.h) mask_feather: k.u * 0.06 opacity: tween(0, 0.9, 0.0, 1.2, @ease_out_sine)
              mask: Ellipse{at: vec2(k.w * 0.5, k.h * 0.05) size: vec2(k.u * 0.95, k.u * 0.8) scale: tween(0.7, 1, 0.0, 2.0, @ease_out_cubic)}
              layers: [Pattern{kind: @wash color: k.accent color2: #x00000000 cell: k.u * 0.35 weight: 0.42 size: vec2(k.w, k.h) speed: 0.2}]}
        Group{name: "red wash" size: vec2(k.w, k.h) mask_feather: k.u * 0.05 opacity: tween(0, 0.8, 0.3, 1.5, @ease_out_sine)
              mask: Ellipse{at: vec2(k.w * 0.04, k.h * 0.55) size: vec2(k.u * 0.6, k.u * 0.5) scale: tween(0.7, 1, 0.3, 2.3, @ease_out_cubic)}
              layers: [Pattern{kind: @wash color: k.accent2 color2: #x00000000 cell: k.u * 0.25 weight: 0.45 size: vec2(k.w, k.h) speed: 0.15}]}
    ] }
    ornaments: fn(k) { [
        Ellipse{name: "ink circle" at: vec2(k.w - k.m - k.u * 0.28, k.m) size: vec2(k.u * 0.28, k.u * 0.28) fill: #x00000000 stroke: k.ink width: 5 * k.s cap: @round trim_end: tween(0, 0.94, 0.2, 1.4, @ease_in_out_cubic)}
        Path{name: "brush stroke" svg: "M 0 12 C 120 -6, 260 22, 420 4" stroke: k.ink width: 14 * k.s cap: @round at: vec2(k.m, k.h - k.m * 1.2) scale: k.s trim_end: tween(0, 1, 0.6, 1.3, @ease_out_cubic)}
    ] }
    screen: fn(k) { [] }
    post: [
        Effect{name: @grain amount: 0.06 size: 1.6}
        Effect{name: @vignette amount: 0.15 feather: 0.8}
    ]
    text_effects: []
}

