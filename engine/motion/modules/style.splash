use mod.motion.*
// Style kits: a palette, a type pairing, a motion language and the layers a frame gets under and over the author's (`Motion{style: @swiss}`).
//
//   use mod.motion.modules.style.*
//   let k = {w: 1920 h: 1080 cx: 960 cy: 540 m: 65 u: 1080 s: 1
//            bg: #xf2f0eb ink: #x111111 accent: #xe3001b accent2: #x111111 muted: #xb9b6ae}
//   Motion{size: vec2(1920, 1080) duration: 4.0 layers: style_kits.swiss.plate(k)}
//
// A kit is data and functions. Its look and suits are what the guide says about it; palette is
// bg (the paper), ink (type), accent, accent2 and muted; display (titles: a Text of size 56 or
// more) and body (everything smaller) are faces {font (a Font) tracking (a fraction of the
// size) stretch (Roboto Flex's width)}; upper sets display titles in capitals; label is the Font
// of `role: @label` Texts; leading the display line height; animate and body_animate the
// typography animators and speed their pace; text3d the Text3D preset and kinetic the
// KineticText kit a layer without one gets; fx a vj_fx background (`style: {kit: … fx: true}`).
// plate (under the author's layers), ornaments and screen (over them) are functions of the
// frame k: its size w h, centre cx cy, margin m, short side u, that against 1080 s, and the
// palette as k.bg k.ink k.accent k.accent2 k.muted (with the author's overrides). post is the
// frame's effects and text_effects what every Text without effects gets.

let swiss = {
    look: "Swiss grid: off-white paper, a 12-column hairline grid drawing down, a red disc, tight black grotesque"
    suits: "product launches, explainers, design and architecture, clean corporate"
    palette: {bg: #xf2f0eb ink: #x111111 accent: #xe3001b accent2: #x111111 muted: #xb9b6ae}
    display: {font: Font{family: "Inter" weight: 900} tracking: -0.035}
    body: {font: Font{family: "Inter" weight: 500} tracking: 0}
    upper: false
    label: Font{family: "JetBrains Mono"}
    leading: 0.95
    animate: @mask_up
    body_animate: @fade_up
    speed: 1.1
    text3d: "slab_stack"
    kinetic: "342_title_card"
    fx: ""
    plate: fn(k) { [
        Rect{name: "paper" size: vec2(k.w, k.h) fill: k.bg}
        Repeat{name: "columns" count: 13 layout: @grid columns: 13 spacing: vec2((k.w - k.m * 2) / 12, 0) at: vec2(k.m, 0) delay: 0.03
            layer: Rect{size: vec2(2, k.h) fill: k.muted opacity: 0.5 anchor: vec2(0.5, 0) scale: tween(vec2(1, 0), vec2(1, 1), 0.0, 0.9, @ease_out_cubic)}}
        Rect{name: "baseline" at: vec2(k.m, k.h - k.m) size: vec2(k.w - k.m * 2, 3) fill: k.ink anchor: vec2(0, 0.5) scale: tween(vec2(0, 1), vec2(1, 1), 0.1, 0.9, @ease_out_expo)}
        Ellipse{name: "red disc" at: vec2(k.w - k.m - k.u * 0.3, k.m) size: vec2(k.u * 0.3, k.u * 0.3) fill: k.accent scale: tween(0, 1, 0.15, 0.75, @ease_out_back)}
    ] }
    ornaments: fn(k) { [
        Text{name: "index" text: "01" font: Font{family: "Inter" weight: 700} size: 30 * k.s color: k.ink at: vec2(k.m, k.m + 30 * k.s) opacity: tween(0, 1, 0.3, 0.6)}
        Path{name: "register" svg: "M -14 0 L 14 0 M 0 -14 L 0 14" stroke: k.ink width: 2 at: vec2(k.w - k.m, k.h - k.m * 1.6) scale: k.s opacity: tween(0, 1, 0.3, 0.6)}
    ] }
    screen: fn(k) { [] }
    post: [Effect{name: @grain amount: 0.025 size: 1.2}]
    text_effects: []
}

let brutalist = {
    look: "Brutalist: raw concrete grey, a thick black frame, a hard orange slab slamming in, hatching, a barcode and a heavy arrow; condensed caps and mono"
    suits: "hype drops, streetwear, manifestos, bold statements"
    palette: {bg: #xe4e4dc ink: #x0a0a0a accent: #xff3d00 accent2: #x1f3dff muted: #x9a9a92}
    display: {font: Font{family: "Anton" weight: 400} tracking: 0.01}
    body: {font: Font{family: "JetBrains Mono" weight: 700} tracking: 0}
    upper: true
    label: Font{family: "JetBrains Mono"}
    leading: 0.72
    animate: @rise
    body_animate: @typewriter
    speed: 1.8
    text3d: "word_punch"
    kinetic: "344_pow_burst"
    fx: ""
    plate: fn(k) { [
        Rect{name: "concrete" size: vec2(k.w, k.h) fill: k.bg}
        Pattern{name: "hatch" kind: @hatch color: k.muted cell: 18 weight: 0.35 at: vec2(k.w * 0.66, 0) size: vec2(k.w * 0.34, k.h) opacity: 0.55}
        Rect{name: "slab" at: vec2(0, k.h * 0.72) size: vec2(k.w * 0.58, k.h * 0.28) fill: k.accent x: keys([0, 0 - k.w * 0.6], [0.35, 0, @ease_out_expo])}
        Rect{name: "frame" at: vec2(k.m * 0.5, k.m * 0.5) size: vec2(k.w - k.m, k.h - k.m) fill: #x00000000 stroke: k.ink width: 14 * k.s}
    ] }
    ornaments: fn(k) { [
        Path{name: "arrow" svg: "M 0 0 L 120 0 M 84 -36 L 120 0 L 84 36" stroke: k.ink width: 12 at: vec2(k.w - k.m * 2.8, k.h - k.m * 1.6) scale: k.s trim_end: tween(0, 1, 0.25, 0.55, @ease_out_expo)}
        Repeat{name: "barcode" count: 16 layout: @grid columns: 16 spacing: vec2(11 * k.s, 0) at: vec2(k.m * 1.2, k.m * 1.2) jitter: {x: 5 * k.s} seed: 3
            layer: Rect{size: vec2(5 * k.s, 70 * k.s) fill: k.ink}}
    ] }
    screen: fn(k) { [] }
    post: [Effect{name: @grain amount: 0.05 size: 1.6}]
    text_effects: []
}

