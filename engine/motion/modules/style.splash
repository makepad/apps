             scale: tween(vec2(1, 0.96), vec2(1, 1), 0.0, 0.4, @ease_out_cubic)}
        Pattern{name: "grid" kind: @grid color: #xf1ead61c cell: k.u * 0.06 weight: 0.04 at: vec2(k.m, k.m) size: vec2(k.w - k.m * 2, k.h - k.m * 2)}
