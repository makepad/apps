        Ellipse{name: "live" at: vec2(k.w - k.m * 1.6 - 14 * k.s, k.m * 1.6 - 4 * k.s) size: vec2(14 * k.s, 14 * k.s) fill: k.accent2 opacity: repeat(keys([0, 1], [0.6, 0.3, @hold]), 1.2, @restart)}
