// The accents module on one plate: every one-shot fired together every 1.6 s, the four loaders
// running under them. A cell per effect, its name below it; copy a call from here.
use mod.motion.modules.accents.*

let cell = fn(i) { return vec2(240.0 + 480.0 * mod(i, 4.0), 190.0 + 300.0 * floor(i / 4.0)) }
let name = fn(i, text) {
    return Text{text: text font: "JetBrains Mono" weight: 500 size: 17 color: #8b8f98 at: cell(i) + vec2(0, 128) align: @center}
}

Motion{
    label: "Accents"
    duration: 6.4
    background: #14161a
    layers: [
        Draw2D{name: "accents" draw: fn(c, t, edit) {
            c.blend(@normal)
            // One firing: 0..1 over the first 1.3 s of every 1.6 s.
            let u = prog(mod(t, 1.6), 0.05, 1.35)
            let p = cell(0.0)
            accent_burst(c, p.x - 100.0, p.y, u, {count: 8 radius: 105})
            accent_burst(c, p.x + 110.0, p.y, u, {count: 12 radius: 105 twist: 60 color: #2fd6e0})
            p = cell(1.0)
            accent_confetti(c, p.x, p.y, u, {count: 18 radius: 150})
            p = cell(2.0)
            accent_ring(c, p.x - 100.0, p.y, u, {radius: 95 echo: 0.25})
            accent_ring(c, p.x + 110.0, p.y, u, {radius: 95 sides: 5 star: 0.45 fill: true color: #ff5a1f})
            p = cell(3.0)
            accent_arc(c, p.x - 100.0, p.y, u, {radius: 85 turns: 1.25 echoes: 2})
            accent_arc(c, p.x + 110.0, p.y, u, {radius: 100 squash: 0.35 tilt: -20 turns: 1.6 width: 4 dash: 12})
            p = cell(4.0)
            accent_swoosh(c, [p.x - 190.0, p.y + 70.0, p.x - 90.0, p.y - 130.0, p.x + 60.0, p.y + 110.0, p.x + 190.0, p.y - 70.0], u, {arrow: 24 echo: true})
            p = cell(5.0)
            accent_swoosh(c, [[p.x - 180.0, p.y + 60.0], [p.x - 60.0, p.y + 60.0], [p.x + 20.0, p.y - 60.0], [p.x + 180.0, p.y - 60.0]], u, {arrow: 22 color: #ff5a1f})
            p = cell(6.0)
            accent_lines(c, p.x, p.y, u, {count: 7 w: 400 h: 130})
            p = cell(7.0)
            accent_target(c, p.x, p.y, u, {radius: 120 sides: 4})
            p = cell(8.0)
            accent_spinner(c, p.x - 130.0, p.y, t, {count: 12 radius: 40})
            accent_spinner(c, p.x, p.y, t, {count: 10 radius: 40 kind: @dot size: 15})
            accent_spinner(c, p.x + 130.0, p.y, t, {count: 12 radius: 40 kind: @tri size: 15 speed: -1})
            p = cell(9.0)
            accent_orbit(c, p.x - 80.0, p.y, t, {radius: 46 echoes: 2})
            accent_orbit(c, p.x + 80.0, p.y, t, {radius: 46 sweep: 350 dash: 11 width: 4})
            p = cell(10.0)
            accent_chevrons(c, p.x, p.y, t, {count: 4 size: 34})
            p = cell(11.0)
            accent_wave(c, p.x, p.y, t, {w: 300 amp: 20 waves: 2.5})
        }}
        name(0.0, "accent_burst")
        name(1.0, "accent_confetti")
        name(2.0, "accent_ring")
        name(3.0, "accent_arc")
        name(4.0, "accent_swoosh")
        name(5.0, "accent_swoosh  points")
        name(6.0, "accent_lines")
        name(7.0, "accent_target")
        name(8.0, "accent_spinner")
        name(9.0, "accent_orbit")
        name(10.0, "accent_chevrons")
        name(11.0, "accent_wave")
    ]
}
