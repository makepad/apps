use mod.scene.*
// 10 000 lit instances with per-instance keyed scale and colour.
Scene3D{ background: #101218 environment: Environment{preset: @studio} camera: Camera{orbit: true yaw: spin(20) pitch: 35 distance: 30 fov: 40}
  lights: [DirectionalLight{position: vec3(3, 6, 4) intensity: 2}]
  children: [Instances{geometry: BoxGeometry{width: 0.2 height: 0.2 depth: 0.2 radius: 0.03 radius_segments: 2} layout: GridLayout{count: vec3(100, 1, 100) spacing: vec3(0.25, 1, 0.25)}
    order: @distance stagger: 0.05 each: {scale: repeat(tween(vec3(1, 1, 1), vec3(1, 6, 1), 0, 1, @ease_in_out_sine), 2) } color_jitter: 0.3 material: MeshStandardMaterial{color: #4f8cff roughness: 0.4}}] }
