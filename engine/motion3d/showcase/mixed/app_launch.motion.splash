use mod.motion.*; use mod.scene; use mod.post
// App launch: a vector title card with a live 3D phone and laptop. The 2D
// background, headline, underline and feature chips are Motion's vector
// layers; the devices are one transparent Scene3D layer between them, with
// shadows caught on an invisible floor so they sit on the 2D backdrop.
// The camera orbits on the beat grid (120 bpm): beats 0-8 orbit, 8-12 push in.
Motion{
    size: vec2(1920, 1080)
    duration: 6.0
    bpm: 120
    layers: [
        Rect{at: vec2(0, 0) size: vec2(1920, 1080) fill: #0d1020}
        Ellipse{at: vec2(760, 140) size: vec2(1400, 1000) fill: #2a1c5a opacity: 0.55 blur: 180}
        Scene3D{
            at: vec2(0, 0)
            size: vec2(1920, 1080)
            bpm: 120
            effects: [Effect{name: @drop_shadow opacity: 0.45 distance: 30 radius: 40 angle: 100}]
            environment: scene.Environment{preset: @softbox intensity: 1.1}
            tone_mapping: @aces
            camera: Camera{
                preset: @hero
                target: vec3(0.6, 0.75, 0)
                distance: 7.5
                focal_length: 45
                moves: [
                    scene.CameraMove{type: @orbit_right start: scene.beat(0) end: scene.beat(8) amount: 35}
                    scene.CameraMove{type: @push_in start: scene.beat(8) end: scene.beat(12) amount: 0.18}
                ]
            }
            post: [scene.ContactShadows{opacity: 0.8 blur: 0.25 far: 1.2} post.DepthOfField{focus: 7.2 f_stop: 4} scene.ColorGrade{contrast: 1.08 saturation: 1.1}]
            lights: [scene.LightRig{preset: @product target: vec3(0.6, 0.6, 0)}]
            children: [
                scene.Device{
                    kind: @laptop
                    position: vec3(1.5, 0, 0)
                    rotation: vec3(0, -28, 0)
                    open: tween(0, 108, 0.3, 1.8, @ease_out_back)
                }
                scene.Device{
                    kind: @phone
                    position: tween(vec3(-0.6, -2.0, 0.6), vec3(-0.6, 0.85, 0.6), 1.0, 2.0, @ease_out_cubic)
                    rotation: tween(vec3(0, 60, -8), vec3(0, 18, -4), 1.0, 2.4, @ease_out_cubic)
                }
                scene.Ground{shadow_only: true shadow_opacity: 0.7}
            ]
        }
        Text{text: "Ship it everywhere" size: 96 weight: 800 color: #ffffff at: vec2(140, 150) by: @letter stagger: 0.03
             opacity: tween(0, 1, 2.0, 2.5) y: tween(40, 0, 2.0, 2.7, @ease_out_back)}
        Path{svg: "M 0 0 L 620 0" stroke: #ff5a36 width: 8 cap: @round at: vec2(144, 280) trim_end: tween(0, 1, 2.5, 3.3, @ease_in_out_cubic)}
        Group{layers: [
            Rect{at: vec2(144, 920) size: vec2(250, 64) radius: 32 fill: #ffffff opacity: 0.12}
            Text{text: "Phone" size: 30 color: #ffffff at: vec2(269, 952) align: @center valign: @center}
        ] opacity: tween(0, 1, 3.2, 3.6)}
        Group{layers: [
            Rect{at: vec2(420, 920) size: vec2(250, 64) radius: 32 fill: #ffffff opacity: 0.12}
            Text{text: "Laptop" size: 30 color: #ffffff at: vec2(545, 952) align: @center valign: @center}
        ] opacity: tween(0, 1, 3.4, 3.8)}
    ]
}
