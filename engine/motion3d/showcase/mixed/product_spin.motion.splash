use mod.motion.*; use mod.scene; use mod.post
// Product spin: a turntable hero in 3D (chrome rings around a glass core
// on a ceramic plinth, reflective studio floor, 3D motion blur and lens
// depth of field) framed by a vector spec card with a render-kit glow.
Motion{
    size: vec2(1920, 1080)
    duration: 6.0
    bpm: 120
    layers: [
        Scene3D{
            at: vec2(0, 0)
            size: vec2(1920, 1080)
            bpm: 120
            background: #0b0c10
            environment: scene.Environment{preset: @studio intensity: 1.3}
            tone_mapping: @aces
            camera: Camera{
                preset: @three_quarter
                target: vec3(0.8, 1.0, 0)
                distance: 7.5
                focal_length: 70
                move: @orbit_right move_start: 0 move_end: 6 move_amount: 50 move_ease: @ease_in_out_sine
            }
            post: [
                scene.ContactShadows{opacity: 0.8 blur: 0.2 far: 1}
                post.DepthOfField{focus: 7.5 f_stop: 2.8}
                post.MotionBlur{shutter: 180 samples: 3}
                post.Bloom{strength: 0.35 threshold: 1.8}
                scene.ColorGrade{contrast: 1.12 temperature: 0.1}
                post.Vignette{amount: 0.35}
            ]
            lights: [scene.LightRig{preset: @dramatic target: vec3(0.8, 1, 0)}]
            children: [
                scene.Turntable{
                    position: vec3(0.8, 0, 0)
                    speed: 40
                    plinth_material: scene.MeshPhysicalMaterial{color: #16171c roughness: 0.3 clearcoat: 1 clearcoat_roughness: 0.05}
                    children: [scene.ShapeSet{preset: @rings position: vec3(0, 1.3, 0) spread: 0.6 color: #ffb347 color2: #7fb2ff speed: 0.6}]
                }
                scene.Ground{color: #07080a roughness: 0.3 reflectivity: 0.4 reflection_blur: 0.2 fade: vec2(3, 12)}
            ]
        }
        Group{opacity: tween(0, 1, 0.6, 1.1) x: tween(-60, 0, 0.6, 1.2, @ease_out_cubic) layers: [
            Rect{at: vec2(110, 300) size: vec2(560, 440) radius: 28 fill: #ffffff opacity: 0.07 stroke: #ffffff width: 1}
            Text{text: "ORBIT ONE" size: 64 weight: 800 color: #ffffff at: vec2(160, 360) effects: [Effect{name: @glow radius: 18 intensity: 1.2 threshold: 0.4}]}
            Text{text: "Three rings, one core" size: 30 color: #aab3c8 at: vec2(160, 450)}
            Path{svg: "M 0 0 L 440 0" stroke: #ffb347 width: 4 at: vec2(160, 520) trim_end: tween(0, 1, 1.2, 2.0, @ease_in_out_cubic)}
            Text{text: "$ 249" size: 72 weight: 800 color: #ffb347 at: vec2(160, 580) opacity: tween(0, 1, 2.0, 2.4)}
        ]}
    ]
}
