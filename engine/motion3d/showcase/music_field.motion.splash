use mod.motion.*; use mod.scene; use mod.post
// An instanced field that plays the music: 12 000 prisms rise with the
// bass in a ring wave from the centre, glow on the hats, and a hero shape
// pulses on every beat. Audio is sampled on the edit's clock, so the pulses
// stay on the grid wherever this clip sits.
Motion{
    size: vec2(1920, 1080)
    duration: 8.0
    layers: [
        Scene3D{
            background: #030308
            environment: scene.Environment{preset: @neon intensity: 0.5 rotation: scene.spin(20)}
            fog: scene.FogExp2{color: #030308 density: 0.022}
            tone_mapping: @aces
            temporal_aa: 2
            camera: Camera{
                orbit: true
                target: vec3(0, 0, 0)
                yaw: scene.spin(12)
                pitch: tween(38, 24, 0, 8, @ease_in_out_sine)
                distance: 22
                focal_length: 35
                shake: scene.follow_music(@beat, 0.0, 0.05)
            }
            post: [
                post.Bloom{strength: 0.9 radius: 0.7 threshold: 0.9}
                scene.ColorGrade{contrast: 1.15 saturation: 1.15 temperature: -0.3 lift: vec4(0.004, 0.0, 0.012, 1)}
                post.Vignette{amount: 0.35}
            ]
            lights: [
                scene.AmbientLight{intensity: 0.35}
                scene.DirectionalLight{position: vec3(-6, 10, 4) intensity: 1.5}
                scene.PointLight{position: vec3(0, 5.5, 0) intensity: scene.follow_music(@beat, 30, 220) color: #ff3a8c distance: 30 cast_shadow: true shadow_softness: 2}
            ]
            children: [
                scene.Instances{
                    geometry: scene.BoxGeometry{width: 0.22 height: 1 depth: 0.22}
                    layout: scene.GridLayout{count: vec3(120, 1, 100) spacing: vec3(0.28, 1, 0.28)}
                    order: @distance
                    stagger: 0.06
                    each: {
                        scale: scene.follow_music(@low, vec3(1, 0.05, 1), vec3(1, 2.4, 1))
                        color: scene.follow_music(@mid, #2a4a9a, #3fd6ff)
                        emissive: scene.follow_music(@high, 0.0, 2.5)
                    }
                    color_jitter: 0.12
                    material: scene.MeshStandardMaterial{color: #ffffff roughness: 0.35 metalness: 0.5}
                }
                scene.Mesh{
                    geometry: scene.IcosahedronGeometry{radius: 1.4 detail: 4}
                    position: vec3(0, 3, 0)
                    rotation: scene.spin(vec3(15, 40, 0))
                    scale: scene.follow_music(@beat, 1.0, 1.35)
                    displace: scene.follow_music(@energy, 0.05, 0.35)
                    displace_speed: 0.6
                    material: scene.MeshPhysicalMaterial{preset: @chrome roughness: 0.12 clearcoat: 1 emissive: #ff3a8c emissive_intensity: scene.follow_music(@beat, 0.1, 3)}
                }
                scene.Points{layout: scene.BallLayout{count: 4000 radius: 14 seed: 3} size: 0.05 color: #8fb8ff opacity: scene.follow_music(@energy, 0.3, 1)}
            ]
        }
    ]
}
