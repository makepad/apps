use mod.scene.*; use mod.post; use mod.kernel
// Sparks on contact: a marble drops on every beat onto a staircase and a
// bar sweeping the floor; wherever something hits hard, a stateful sim
// bursts sparks that fly, fall and fade. The sim steps with physics
// (every second 1/240 s step), so it is seeded and seekable like the
// bodies: every export and scrub gives the same sparks.
let drop = Kernel{
    out: kernel.output(kernel.Body)
    instance: fn(i) {
        out[i] = Body{pos: vec3(-1.6 + 0.08 * rand11(seed, i, 0), 3.2, 0.1 * rand11(seed, i, 1)), vel: vec3(0.9, 0.0, 0.0), delay: float(i) * 0.5, bounce: 0.45, life: 6.0, color: vec4(0.35 + 0.3 * rand01(seed, i, 2), 0.7, 1.0, 1.0)}
    }
}
let sparks = Sim{
    state: {pos: vec3(0.0, -10.0, 0.0) vel: vec3(0.0, 0.0, 0.0) size: 0.0 color: vec4(1.0, 0.8, 0.4, 0.0)}
    count: 512
    every: 2
    hits: kernel.input(contacts("marbles"))
    dt: kernel.param(0.008333)
    update: fn(i) {
        next[i] = prev[i]
        let n = int(hits_count)
        let k = i % max(n, 1)
        // A new hit (one this sim step) takes every spark whose index maps to it.
        let fresh = n > 0 && hits[k].time > time - dt * 1.5 && hits[k].speed > 1.0
        // Spark i joins hit k only if it is one of the 24 its lane owns.
        let first = i / max(n, 1) < 24
        if prev[i].color.w <= 0.0 && fresh && first {
            let d = rand_dir(seed, i, int(time * 240.0))
            next[i].pos = hits[k].pos
            next[i].vel = (d + hits[k].normal * 1.2) * (0.8 + 1.4 * rand01(seed, i, 7))
            next[i].size = 0.035
            next[i].color = vec4(4.0, 2.4, 0.8, 1.0)
        } elif prev[i].color.w > 0.0 {
            next[i].vel = prev[i].vel + vec3(0.0, -6.0, 0.0) * dt
            next[i].pos = prev[i].pos + next[i].vel * dt
            next[i].color = vec4(prev[i].color.x, prev[i].color.y, prev[i].color.z, max(prev[i].color.w - dt * 1.8, 0.0))
        }
    }
}
Scene3D{ background: #07080c tone_mapping: @aces bpm: 120
    camera: Camera{position: vec3(0.4, 2.0, 6.0) target: vec3(0.2, 1.0, 0) fov: 42}
    lights: [HemisphereLight{sky_color: #ffffff ground_color: #222633 intensity: 0.8} DirectionalLight{position: vec3(-3, 6, 5) intensity: 2.4 cast_shadow: true}]
    post: [post.Bloom{strength: 0.9 threshold: 0.8}]
    physics: Physics{step: 1 / 240 seed: 11
        bodies: [
            Body{name: "floor" shape: @plane}
            Body{name: "step1" group: "stairs" shape: @box fixed: true position: vec3(-1.2, 1.6, 0) size: vec3(0.8, 0.2, 1.0) scale: vec3(0.8, 0.2, 1.0) bounce: 0.3}
            Body{name: "step2" group: "stairs" shape: @box fixed: true position: vec3(-0.3, 1.1, 0) size: vec3(0.8, 0.2, 1.0) scale: vec3(0.8, 0.2, 1.0) bounce: 0.3}
            Body{name: "step3" group: "stairs" shape: @box fixed: true position: vec3(0.6, 0.6, 0) size: vec3(0.8, 0.2, 1.0) scale: vec3(0.8, 0.2, 1.0) bounce: 0.3}
            Body{name: "bar" shape: @box kinematic: true position: vec3(1.8, 0.12, 0) rotation: tween(vec3(0, 0, 0), vec3(0, 1440, 0), 0, 8) size: vec3(1.6, 0.12, 0.12) scale: vec3(1.6, 0.12, 0.12) color: #ff5a36}
        ]
        spawn: [Spawn{at: beat(1) group: "marbles" count: 12 shape: @sphere size: vec3(0.16, 0.16, 0.16) from: drop}]}
    children: [
        Mesh{geometry: PlaneGeometry{width: 12 height: 12} rotation: vec3(-90, 0, 0) material: MeshStandardMaterial{color: #16181f roughness: 0.9}}
        Instances{source: bodies("stairs") geometry: BoxGeometry{width: 1 height: 1 depth: 1} material: MeshStandardMaterial{color: #c9d2e3 roughness: 0.6}}
        Instances{source: bodies("bar") geometry: BoxGeometry{width: 1 height: 1 depth: 1} material: MeshStandardMaterial{color: #ffffff roughness: 0.4}}
        Instances{source: bodies("marbles") geometry: SphereGeometry{radius: 0.08 width_segments: 24 height_segments: 16} material: MeshPhysicalMaterial{color: #ffffff roughness: 0.15 clearcoat: 1}}
        Points{source: sparks size: 1 blending: @additive}
    ] }
