use mod.motion.*; use mod.scene; use mod.post
// Product hero turntable: the library's race car (asset lib-8962) in a
// studio — car paint with clearcoat and metallic flakes, rubber tyres,
// tinted glass, brushed-metal trim — on a glossy floor that reflects it and
// fades into the backdrop, with contact shadows, a key/fill/rim light rig
// and the studio HDRI in every reflection. An 85 mm lens at f/2.8 orbits
// slowly with an eased dolly; ACES, a warm grade, 4x jittered antialiasing.
Motion{
    size: vec2(1920, 1080)
    duration: 6.0
    layers: [
        Scene3D{
            background: #0c0d10
            environment: scene.Environment{preset: @softbox intensity: 1.3 rotation: tween(20, 60, 0, 6)}
            tone_mapping: @aces
            exposure: 1.15
            temporal_aa: 4
            camera: Camera{
                orbit: true
                target: vec3(0, 0.35, 0)
                yaw: tween(-50, 25, 0, 6, @ease_in_out_sine)
                pitch: tween(16, 9, 0, 6, @ease_in_out_sine)
                distance: tween(8.4, 7.2, 0, 6, @ease_in_out_cubic)
                focal_length: 85
            }
            post: [
                scene.ContactShadows{opacity: 0.85 blur: 0.25 far: 0.8}
                scene.SSAO{radius: 0.25 intensity: 0.8}
                post.DepthOfField{focus: tween(8.4, 7.2, 0, 6, @ease_in_out_cubic) f_stop: 2.8}
                post.Bloom{strength: 0.25 threshold: 2.5}
                scene.ColorGrade{contrast: 1.12 saturation: 1.08 temperature: 0.15 lift: vec4(0.004, 0.004, 0.01, 1)}
                post.Vignette{amount: 0.35}
            ]
            lights: [scene.LightRig{preset: @product intensity: 1.0 target: vec3(0, 0.4, 0)}]
            children: [
                scene.Model{
                    src: asset("lib-8962", "1")
                    fit: 2.6
                    ground: true
                    rotation: vec3(0, 20, 0)
                    materials: [
                        scene.MaterialOverride{name: "red" preset: @car_paint color: #b3121f}
                        scene.MaterialOverride{name: "carTire" preset: @rubber}
                        scene.MaterialOverride{name: "glass" preset: @glass color: #9fb4c8 roughness: 0.05}
                        scene.MaterialOverride{name: "grey" preset: @brushed_metal color: #8a8d92}
                    ]
                }
                scene.Ground{color: #0e0f12 roughness: 0.3 reflectivity: 0.4 reflection_blur: 0.25 radius: 30 fade: vec2(3.5, 11)}
                scene.Line3D{
                    points: [vec3(-1.6, 1.55, -1.8), vec3(1.6, 1.55, -1.8)]
                    width: 3
                    color: #ff5a36
                    trim_end: tween(0, 1, 0.6, 2.0, @ease_in_out_cubic)
                }
            ]
        }
    ]
}
