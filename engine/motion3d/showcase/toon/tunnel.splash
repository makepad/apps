use mod.scene.*
// Ink tunnel and tower: one-point perspective in black ink on paper. The
// camera pushes down a tunnel of rings, then cranes up the podium tower.
Scene3D{ look: @ink bpm: 120
  camera: Camera{position: keys([0, vec3(0, 1.2, 14)], [3.5, vec3(0, 1.2, 1.5), @ease_in_out_cubic], [6, vec3(2.5, 6.5, 4), @ease_in_out_cubic])
                 target: keys([0, vec3(0, 1.2, 0)], [3.5, vec3(0, 1.3, -6), @ease_in_out_cubic], [6, vec3(0, 3.5, -8), @ease_in_out_cubic]) fov: 50}
  children: [
    Instances{geometry: TorusGeometry{radius: 2.2 tube: 0.14 radial_segments: 16 tubular_segments: 64} layout: LineLayout{count: 12 start: vec3(0, 1.4, 12) end: vec3(0, 1.4, -2)}
      material: MeshStandardMaterial{color: #cfcfcf}}
    Instances{geometry: BoxGeometry{width: 0.4 height: 3 depth: 0.4} layout: LineLayout{count: 8 start: vec3(-3, 1.5, 12) end: vec3(-3, 1.5, -2)} material: MeshStandardMaterial{color: #ffffff}}
    Instances{geometry: BoxGeometry{width: 0.4 height: 3 depth: 0.4} layout: LineLayout{count: 8 start: vec3(3, 1.5, 12) end: vec3(3, 1.5, -2)} material: MeshStandardMaterial{color: #ffffff}}
    // The podium tower: stacked, stepped blocks.
    Group3D{position: vec3(0, 0, -8) children: [
      Mesh{geometry: BoxGeometry{width: 4 height: 1 depth: 4} position: vec3(0, 0.5, 0) material: MeshStandardMaterial{color: #9a9a9a}}
      Mesh{geometry: BoxGeometry{width: 3 height: 1.4 depth: 3} position: vec3(0, 1.7, 0) material: MeshStandardMaterial{color: #c8c8c8}}
      Mesh{geometry: BoxGeometry{width: 2 height: 1.8 depth: 2} position: vec3(0, 3.3, 0) material: MeshStandardMaterial{color: #e8e8e8}}
      Mesh{geometry: TorusKnotGeometry{radius: 0.5 tube: 0.16} position: vec3(0, 4.9, 0) rotation: spin(vec3(0, 60, 0)) material: MeshStandardMaterial{color: #ffffff}}
    ]}
    Mesh{geometry: PlaneGeometry{width: 60 height: 60} rotation: vec3(-90, 0, 0) material: MeshStandardMaterial{color: #dddddd}}
  ] }
