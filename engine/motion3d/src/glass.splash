finish: fn(c: vec4) -> vec4 {
            // Glass (MeshPhysicalMaterial transmission): what is behind the
            // surface, refracted through it and tinted, shows through; the
            // lit colour stays as its reflection. params: transmission, ior,
            // thickness (world units), roughness. The scene behind (the frame
            // drawn without its glass) is bound on detail_map.
            let p = self.mat_pos()
            let n = self.mat_geo_normal()
            let v = normalize(self.eye.xyz - p)
            let tr = clamp(self.params.x, 0.0, 1.0)
            let ior = max(self.params.y, 1.0)
            let thickness = max(self.params.z, 0.05)
            let rough = clamp(self.params.w, 0.0, 1.0)
            // Where the refracted ray leaves the body, projected back to the
            // screen.
            let i = 0.0 - v
            let eta = 1.0 / ior
            let ci = dot(n, i)
            let k = 1.0 - eta * eta * (1.0 - ci * ci)
            var r = i - n * (2.0 * ci)
            if k >= 0.0 {
                r = i * eta - n * (eta * ci + sqrt(k))
            }
            let exit = p + r * thickness * 1.5
            let clip = self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(exit.x, exit.y, exit.z, 1.0))
            let suv = clamp(vec2(clip.x / clip.w * 0.5 + 0.5, 0.5 - clip.y / clip.w * 0.5), vec2(0.0, 0.0), vec2(1.0, 1.0))
            let blur = rough * rough * 0.02
            var behind = self.detail_map.sample_nearest(suv).xyz * 0.4
            behind = behind + self.detail_map.sample_nearest(suv + vec2(blur, 0.0)).xyz * 0.15
            behind = behind + self.detail_map.sample_nearest(suv - vec2(blur, 0.0)).xyz * 0.15
            behind = behind + self.detail_map.sample_nearest(suv + vec2(0.0, blur)).xyz * 0.15
            behind = behind + self.detail_map.sample_nearest(suv - vec2(0.0, blur)).xyz * 0.15
            // The body's colour, deeper with its thickness.
            let albedo = self.material_color(self.mat_uv()).xyz
            let e = thickness * 0.5 + 0.5
            let tint = pow(max(albedo, vec3(0.0001, 0.0001, 0.0001)), vec3(e, e, e))
            let ndv = clamp(dot(n, v), 0.0, 1.0)
            let fr = 0.04 + 0.96 * pow(1.0 - ndv, 5.0)
            let through = behind * tint * (1.0 - fr)
            return vec4(mix(c.xyz, through + c.xyz * fr, tr), c.w)
        }
