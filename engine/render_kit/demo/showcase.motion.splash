use mod.motion.*
// The render kit showcase as a Motion document (EDITS.md §10.2): the same
// scene `makepad-render-kit demo` renders, written the way an author or the
// AI writes it once the Motion layer `effects: [...]` list is wired to the
// kit (see reports/R2-render-kit.md, "Hook for M1"). Every effect is
// `Effect{name: @<catalog name> <param>: <value | tween | keys> ...}`;
// the catalog and every parameter are in design/RENDER-KIT.md.
Motion{
    label: "Render kit showcase"
    size: vec2(1920, 1080) duration: 6.0 fps: 30
    background: #0b0d12
    // The comp camera for 2.5D layers: orbiting slowly, shallow focus.
    camera: Camera{
        fov: 39.6
        orbit: fn(t) { vec2(12.0 * sin(t * 0.5), 6.0) }
        aperture: 36
    }
    layers: [
        // Background: a conic multi-stop gradient with drifting fbm noise in
        // soft light, a slow ripple, a curve and a vignette.
        Rect{at: vec2(0, 0) size: vec2(1920, 1080) fill: #ffffff
             effects: [
                 Effect{name: @gradient kind: @conic start: vec2(0.5, 0.55)
                        end: fn(t) { vec2(0.5 + cos(t * 0.3), 0.55 + sin(t * 0.3)) }
                        stops: [[0.0, #0d1230], [0.35, #400f5a], [0.7, #05405a], [1.0, #0d1230]]}
                 Effect{name: @noise scale: 360 evolution: 0.4 blend: @soft_light opacity: 0.8}
                 Effect{name: @ripple wavelength: 180 amplitude: 12 speed: 120}
                 Effect{name: @curves master: [vec2(0, 0.03), vec2(0.5, 0.45), vec2(1, 1)]}
                 Effect{name: @vignette amount: 0.6}
             ]}
        // A comet with echo trails and true motion blur.
        Ellipse{name: "comet" size: vec2(48, 48) fill: #66e6ff
                at: fn(t) { vec2(1920 * (0.1 + 0.8 * (sin(t * 0.9) * 0.5 + 0.5)), 1080 * (0.78 + 0.1 * cos(t * 1.7))) }
                blend: @screen
                effects: [
                    Effect{name: @motion_blur samples: 12}
                    Effect{name: @echo count: 8 delay: 0.06 decay: 0.7 mode: @add}
                ]}
        // The title: outlined, bevelled, flipped in on a 3D plane through
        // the camera (depth of field), motion-blurred, shadowed, glowing,
        // revealed by a feathered wipe; particles rise out of its glyphs.
        Text{name: "title" text: "RENDER KIT" font: Font{family: "Inter" weight: 800} size: 192 align: @center at: vec2(960, 540)
             effects: [
                 Effect{name: @stroke width: 6 color: #ff8c33}
                 Effect{name: @bevel size: 12 depth: 2}
                 Effect{name: @transform_3d
                        rotation: keys([0.0, vec3(70, -30, 0)], [1.5, vec3(0, 0, 0), @ease_out_back], [6.0, vec3(0, 25, 0), @ease_in_out_cubic])
                        position: tween(vec3(0, 0, 400), vec3(0, 0, 0), 0.0, 1.5, @ease_out_cubic)}
                 Effect{name: @motion_blur samples: 8}
                 Effect{name: @drop_shadow distance: 20 radius: 16}
                 Effect{name: @glow threshold: 0.8 radius: 20 intensity: 0.35}
                 Effect{name: @mask size: tween(vec2(0.1, 1), vec2(2, 1), 0.0, 1.5) feather: 80}
                 Effect{name: @particles emitter: @layer from: @title size: vec2(0.8, 0.3) rate: 1500 start: 1.0
                        life: 1.4 speed: 80 spread: 360 gravity: vec2(0, -80) particle_size: 8 size_end: 1 turbulence: 24}
             ]}
        // A path drawing on with tapered ends.
        Rect{at: vec2(0, 0) size: vec2(1920, 1080) fill: #00000000
             effects: [
                 Effect{name: @stroke_path svg: "M 160 940 C 600 660, 1320 1220, 1760 940" width: 20
                        taper_start: 0.3 taper_end: 0.3 color: #ffcc4d
                        trim_end: tween(0, 1, 0.5, 3.0, @ease_in_out)}
             ]}
        // Finishing on the whole comp: a Group of everything above could
        // carry these instead; here a Shader-free adjustment group.
        Group{layers: []
              effects: [
                  Effect{name: @bloom threshold: 0.8 radius: 80 intensity: 0.35}
                  Effect{name: @halation radius: 12 amount: 0.4}
                  Effect{name: @turbulence amount: tween(0, 12, 4.5, 6.0) size: 160}
                  Effect{name: @chromatic_aberration amount: 6}
                  Effect{name: @hue_saturation saturation: 0.15}
                  Effect{name: @grain amount: 0.05}
              ]}
    ]
}
