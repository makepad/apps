// A sheet of chainmail: every link interlocked with its four neighbours, printed flat in one go
// and held together by contact alone. It comes off the bed as cloth: try it in Mechanics.
use mod.model.*
use mod.fab.*
let m = mod.model

let mail_width = param(80mm, min: 30mm, max: 200mm, step: 1mm, label: "Width", group: "Chainmail sheet")
let mail_depth = param(60mm, min: 30mm, max: 200mm, step: 1mm, label: "Depth", group: "Chainmail sheet")
let mail_size = param(6mm, min: 5mm, max: 6.5mm, step: 0.1mm, label: "Link half size", group: "Chainmail sheet", hint: "from the link's centre to the middle of its bar")
let mail_bar = param(0.8mm, min: 0.6mm, max: 1mm, step: 0.05mm, label: "Bar radius", group: "Chainmail sheet")

let sheet = m.mail(Rect{size: [mail_width mail_depth]}, {size: mail_size bar: mail_bar})

object(sheet, name: "Chainmail sheet")
