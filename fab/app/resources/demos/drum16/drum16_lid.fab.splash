// The analog drum machine's lid, keycaps and knobs (its board, base and electronics are on "Analog
// drum machine"): the lid with its 20 clear light pipes, the 20 keycaps and the eight knobs, all
// inside the part of the bed both nozzles reach, so the plate prints whichever nozzle holds a
// colour.
use mod.fab.*

script("drum16.cad.splash")

// The lid is dark, its pipes clear, the keycaps and knobs dark too.
color("Charcoal", rgb: #x2b2d31, material: "PETG")
color("Graphite", rgb: #x303237, material: "PETG")
color("Clear", rgb: #xe6ebe6, material: "PETG")

// The lid is 219.8 x 164.8 mm. Turned a quarter turn about its centre (175, 120), it is 92.6 to
// 257.4 mm across, inside both nozzles' reach (25 to 325 mm on the 350 mm bed); it starts 229.8 mm
// along the script's X, hence its origin's Y. The base and the board print on the other plate.
place("drum16", object: "Lid", at: [175mm, -109.8mm], rotate: 90deg, color: "Graphite")
place("drum16", object: "Base", show: false)
place("drum16", object: "Board", show: false)

let pins = [
    "Pin keys.keys[0][0].sw" "Pin keys.keys[0][1].sw" "Pin keys.keys[0][2].sw" "Pin keys.keys[0][3].sw"
    "Pin keys.keys[1][0].sw" "Pin keys.keys[1][1].sw" "Pin keys.keys[1][2].sw" "Pin keys.keys[1][3].sw"
    "Pin keys.keys[2][0].sw" "Pin keys.keys[2][1].sw" "Pin keys.keys[2][2].sw" "Pin keys.keys[2][3].sw"
    "Pin keys.keys[3][0].sw" "Pin keys.keys[3][1].sw" "Pin keys.keys[3][2].sw" "Pin keys.keys[3][3].sw"
    "Pin keys.keys[4][0].sw" "Pin keys.keys[4][1].sw" "Pin keys.keys[4][2].sw" "Pin keys.keys[4][3].sw"
]
for row in 0..2 {
    for col in 0..10 {
        place("drum16", object: pins[row * 10 + col], at: [35mm + col * 16mm, 245mm + row * 16mm], color: "Charcoal")
    }
}
let knobs = ["Knob tempo" "Knob shuffle" "Knob drum.decay" "Knob drum.tune" "Knob snare.snap" "Knob lt.tune" "Knob hats.decay" "Knob mix.vol"]
for i in 0..knobs.len() {
    place("drum16", object: knobs[i], at: [35mm + i * 25mm, 285mm], color: "Charcoal")
}
