// A serpent dragon that flexes: a horned head, seventeen faceted armour plates and a spade at its
// tail, printed fused to one TPU spine that runs through them all. Between each two
// plates the spine runs free a few millimetres, and there the dragon bends side to side and
// springs back to the pose it printed in. Four clawed legs, a spike on every plate. Two to four
// filaments with the spine, laid in layers so each nozzle holds one at a time: jade armour; gold
// scales, eyes, crown, spikes and horns; ivory tips on the tallest spikes and the horns.
use mod.model.*
use mod.fab.*
let m = mod.model

let s = param(1, min: 1, max: 1.3, step: 0.05, label: "Size", group: "Dragon", kind: "ratio", hint: "scales the dragon and its spine's free runs")
let filaments = param(4, min: 2, max: 4, step: 1, label: "Filaments", group: "Dragon", hint: "with the TPU spine: 2 jade armour, 3 adds gold scales, eyes, crown, spikes and horns, 4 ivory tips")
let spine_t = param(1.6mm, min: 1.2mm, max: 2.4mm, step: 0.1mm, label: "Spine thickness", group: "Spine", hint: "thicker springs back harder; it bends side to side, about its tall side")

// The parts' centres on the bed, from the head back, and each part's heading (toward the head):
// the neck turned, the body gently the other way, the tail curled. Consecutive centres sit
// exactly the back of one, a free run of spine and the front of the next apart; the spine runs
// straight from centre to centre, so each free run is straight.
let cx = [0.00mm, -16.00mm, -26.67mm, -36.39mm, -46.63mm, -59.19mm, -72.81mm, -87.09mm, -101.58mm, -116.07mm, -129.54mm, -140.58mm, -148.94mm, -152.62mm, -150.49mm, -143.24mm, -134.02mm, -126.94mm, -124.82mm]
let cz = [0.00mm, 0.00mm, -2.66mm, -7.83mm, -15.83mm, -23.08mm, -28.04mm, -30.56mm, -31.06mm, -30.56mm, -31.50mm, -35.52mm, -43.04mm, -53.15mm, -63.17mm, -69.70mm, -70.34mm, -65.20mm, -56.71mm]
let hx = [1.0000, 0.9951, 0.9336, 0.8347, 0.8312, 0.9063, 0.9659, 0.9945, 1.0000, 0.9999, 0.9801, 0.8593, 0.5639, 0.0766, -0.4929, -0.9169, -0.9640, -0.5592, -0.2419]
let hz = [-0.0000, 0.0993, 0.3584, 0.5507, 0.5560, 0.4226, 0.2588, 0.1045, -0.0000, 0.0156, 0.1984, 0.5114, 0.8259, 0.9971, 0.8701, 0.3991, -0.2659, -0.8290, -0.9703]
// Each plate's front and back (from its centre, along its heading), half width and height:
// three neck plates, six body plates, eight tail plates.
let front = [3.5mm, 3.5mm, 3.5mm, 5mm, 5mm, 5mm, 5mm, 5mm, 5mm, 4mm, 3.75mm, 3.5mm, 3.25mm, 3mm, 2.75mm, 2.5mm, 2.25mm]
let half_w = [5.5mm, 5.8mm, 6.2mm, 7.5mm, 9mm, 9.5mm, 9.5mm, 9mm, 8mm, 7mm, 6.2mm, 5.5mm, 4.8mm, 4.2mm, 3.7mm, 3.3mm, 3mm]
let tall = [7.5mm, 7.8mm, 8.2mm, 9mm, 10mm, 10.5mm, 10.5mm, 10mm, 9.5mm, 8.5mm, 8mm, 7.5mm, 7mm, 6.5mm, 6mm, 5.8mm, 5.5mm]
// The spine: a TPU ribbon on edge on the bed, its tall side up.
let spine_h = 3.6mm

// A point `a` along part k's heading and `w` across it, as a ground sketch's [u v] (v is -Z).
fn pt(k, a, w) { [(cx[k] + a * hx[k] - w * hz[k]) * s, -(cz[k] + a * hz[k] + w * hx[k]) * s] }
fn at3(k, a, w, y) { [(cx[k] + a * hx[k] - w * hz[k]) * s, y * s, (cz[k] + a * hz[k] + w * hx[k]) * s] }
// An armour plate's outline: pointed front and back cut to `e` either side of the spine, widest
// at `w` a third of the way out.
fn octagon(k, f, b, w, e) { Polygon{points: [pt(k, f, e) pt(k, 0.35 * f, w) pt(k, -0.35 * b, w) pt(k, -b, e) pt(k, -b, -e) pt(k, -0.35 * b, -w) pt(k, 0.35 * f, -w) pt(k, f, -e)]} }
fn lesser(a, b) { if a < b { a } else { b } }
// A faceted plate: its outline on the bed, a little in at half height, a ridge on top. Its ends
// stay narrower than its middle all the way up.
fn plate(k, f, w, h) {
    let e = if w * 0.35 > 2.6mm { w * 0.35 } else { 2.6mm }
    m.loft({sections: [Section{sketch: octagon(k, f, f, w, e) at: 0} Section{sketch: octagon(k, f * 0.95, f * 0.95, w * 0.82, lesser(e * 0.9, w * 0.6)) at: h * 0.5 * s} Section{sketch: octagon(k, f * 0.75, f * 0.75, w * 0.32, lesser(e * 0.45, w * 0.24)) at: h * s}]})
}
// A spike on a plate's ridge, its foot well inside the plate (narrower than its ridge).
fn spike(k, w, h) { m.cylinder({radius: w * 0.26 * s top_radius: 0.2mm height: h * 0.75 * s at: at3(k, 0, 0, h * 1.175)}) }

// The head (part 0): a long snout tapering up to a skull, the spine entering it from behind.
let head_out = [[-8mm, 3.5mm] [-6mm, 7.5mm] [0, 10mm] [6mm, 9mm] [11mm, 6.5mm] [16mm, 5mm] [20mm, 3mm] [21.5mm, 0] [20mm, -3mm] [16mm, -5mm] [11mm, -6.5mm] [6mm, -9mm] [0, -10mm] [-6mm, -7.5mm] [-8mm, -3.5mm]]
fn head_section(sa, sw, a0) { Polygon{points: for p in head_out { pt(0, a0 + sa * (p[0] - a0), sw * p[1]) }} }
let skull = m.loft({sections: [Section{sketch: head_section(1, 1, 2mm) at: 0} Section{sketch: head_section(0.93, 0.84, 2mm) at: 4.5mm * s} Section{sketch: head_section(0.55, 0.5, 0) at: 9mm * s}]})
// Horns sweep back from the skull, each section further back and smaller as it rises.
let hex = [[1, 0] [0.5, 0.866] [-0.5, 0.866] [-1, 0] [-0.5, -0.866] [0.5, -0.866]]
fn ring(a, w, r) { Polygon{points: for d in hex { pt(0, a + r * d[0], w + r * d[1]) }} }
let horns = for side in [-1, 1] {
    m.loft({sections: [Section{sketch: ring(-1mm, side * 3.4mm, 2mm) at: 6.5mm * s} Section{sketch: ring(-3.2mm, side * 3.9mm, 1.5mm) at: 11mm * s} Section{sketch: ring(-6mm, side * 4.6mm, 0.5mm) at: 15.5mm * s}]})
}
let head = m.union(skull, horns)

// The legs: a clawed foot flat on the bed either side of the second and fifth body plates.
let toes = [[-3.5mm, -2.5mm] [3.5mm, -2.5mm] [4.5mm, 4mm] [8.5mm, 7.5mm] [5.2mm, 7.8mm] [6mm, 10.8mm] [3.2mm, 9.2mm] [2.2mm, 11.8mm] [0.6mm, 8.6mm] [-2.5mm, 4mm]]
fn foot(k, side, w) { Polygon{points: for q in toes { pt(k, q[0], side * (w + q[1])) }} }
fn leg(k, side) { m.extrude({sketch: foot(k, side, half_w[k - 1]) height: 3.6mm * s draft: 12°}) }

// Plates 1..17 (front, half width and height from index k - 1), each with its spike: three on
// the neck, six on the body (the second and fifth with the legs), eight on the tail.
let shells = for k in 1..18 { plate(k, front[k - 1], half_w[k - 1], tall[k - 1]) }
let spikes = for k in 1..18 { spike(k, half_w[k - 1], tall[k - 1]) }
let legs = for k in [5, 8] { [leg(k, -1) leg(k, 1)] }
let neck = for i in 0..3 { m.union(shells[i], spikes[i]) }
let body = for i in 3..9 { if i == 4 { m.union(shells[i], [spikes[i] legs[0][0] legs[0][1]]) } else { if i == 7 { m.union(shells[i], [spikes[i] legs[1][0] legs[1][1]]) } else { m.union(shells[i], spikes[i]) } } }
let tail = for i in 9..17 { m.union(shells[i], spikes[i]) }

// The tail's spade (part 18): a leaf on the bed, its rim upright a little, a ridge along it.
let spade_out = [[3mm, 2.4mm] [0, 5mm] [-5mm, 7mm] [-8mm, 4.5mm] [-10.5mm, 0] [-8mm, -4.5mm] [-5mm, -7mm] [0, -5mm] [3mm, -2.4mm]]
fn spade_section(sw) { Polygon{points: for p in spade_out { pt(18, p[0], sw * p[1]) }} }
let spade = m.loft({sections: [Section{sketch: spade_section(1) at: 0} Section{sketch: spade_section(1) at: 1mm * s} Section{sketch: spade_section(0.35) at: 5.5mm * s}]})

// The spine: one sweep of a ribbon's section on edge along the dragon's line, from the head's
// centre through each part's centre to the spade's, straight from centre to centre, standing on
// the bed. Where it turns (inside a plate) its section stands square across the turn.
let ribbon = Polygon{points: [[0, -spine_t / 2] [spine_h * s, -spine_t / 2] [spine_h * s, spine_t / 2] [0, spine_t / 2]]}
let spine = m.sweep({sketch: ribbon path: for k in 0..19 { [cx[k] * s, 0, cz[k] * s] }})

let back = m.bond(spine, [head neck[0] neck[1] neck[2] body[0] body[1] body[2] body[3] body[4] body[5] tail[0] tail[1] tail[2] tail[3] tail[4] tail[5] tail[6] tail[7] spade])

object(head, name: "Flex dragon")

let jade = Material{albedo: [0.06 0.40 0.27] name: "Jade"}
let gold = Material{albedo: [0.92 0.68 0.12] name: "Gold"}
let ivory = Material{albedo: [0.93 0.89 0.78] name: "Ivory"}
let ember = Material{albedo: [0.72 0.10 0.08] name: "Ember"}
// The colours lie in layers, so no layer needs two hard filaments on one nozzle: below the
// spine's top only jade beside it; over it jade with gold scales, eyes, crown, spikes and horns;
// and above the tallest plate (`tips`) ivory, the tips of the spikes and horns.
let over = spine_h * s + 0.4mm
let tips = 10.6mm * s
// A box over part k's outline, `f` ahead of its centre, `b` behind, `w` either side.
fn rect(k, f, b, w) { Polygon{points: [pt(k, f, w) pt(k, -b, w) pt(k, -b, -w) pt(k, f, -w)]} }
fn greater(a, b) { if a > b { a } else { b } }
// A plate's gold scale: its ridge from 0.6 of its height up, and down each flank in a point to a
// quarter of it (never into the spine's layers), so the flanks show a row of gold chevrons down
// the dragon; its spike stands in it.
fn gilt(k, f, w, h) {
    let a = w * 1.2
    let lo = greater(h * 0.25 * s, over)
    let mid = greater(h * 0.6 * s, lo + 1mm * s)
    m.loft({sections: [Section{sketch: rect(k, f * 0.02, f * 0.02, a) at: lo} Section{sketch: rect(k, f * 0.35, f * 0.35, a) at: mid} Section{sketch: rect(k, f * 1.15, f * 1.15, a) at: mid + h * 0.02 * s} Section{sketch: rect(k, f * 1.15, f * 1.15, a) at: 30mm * s}]})
}
// Gold scales on every plate, a gold crown over the skull and its horns, and gold eyes.
if filaments >= 3 {
    m.fill(m.loft({sections: [Section{sketch: rect(0, 23mm, 9mm, 11mm) at: 7.2mm * s} Section{sketch: rect(0, 23mm, 9mm, 11mm) at: 30mm * s}]}), gold)
    for k in 1..18 { m.fill(gilt(k, front[k - 1], half_w[k - 1], tall[k - 1]), gold) }
    for side in [-1, 1] { m.fill(m.sphere({radius: 1.5mm * s at: at3(0, 9mm, side * 6mm, 5.3mm)}), gold) }
}
// Ivory tips: everything above the tallest plate.
if filaments >= 4 {
    m.fill(m.box({size: [400mm * s, 60mm * s, 400mm * s] at: [-65mm * s, tips + 30mm * s, -35mm * s]}), ivory)
}
// The spine prints in TPU all through.
m.fill(spine, ember)
