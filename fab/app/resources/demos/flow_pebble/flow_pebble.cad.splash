// A river pebble with flow lines drawn over it: cream lines on slate, each following a swirling
// flow over the stone's skin a spacing from the next and stopping short of the others, so they
// sweep round its curves like the bands of a water-worn stone. Two filaments; the lines' spacing,
// swirl and seed are its knobs. Two ellipsoids blended into a lopsided stone, its underside cut
// flat near its widest so it stands and prints with nothing under it: one distance field, so it
// renders and edits live.
use mod.model.*
use mod.fab.*
let m = mod.model

let length = param(72mm, min: 30mm, max: 160mm, step: 1mm, label: "Length", group: "Pebble")
let breadth = param(50mm, min: 20mm, max: 120mm, step: 1mm, label: "Breadth", group: "Pebble")
let height = param(28mm, min: 10mm, max: 80mm, step: 0.5mm, label: "Height", group: "Pebble")
let spacing = param(3.5mm, min: 2mm, max: 12mm, step: 0.1mm, label: "Spacing", group: "Lines", hint: "from one line to the next")
let swirl = param(6, min: 1, max: 30, step: 0.5, label: "Swirl", group: "Lines", hint: "how far across the flow's swirls are, in spacings")
let seed = param(2, min: 1, max: 999, step: 1, label: "Seed", group: "Lines", kind: "seed", hint: "another whole number draws another flow")

// the stone: its upright radius set so the cut, a third of it under the middle, is at the floor
let up = height / 1.3
let stone = m.ellipsoid({radii: [length / 2, up, breadth / 2] at: [0, up * 0.3, 0]})
let knuckle = m.ellipsoid({radii: [length * 0.26, up * 0.8, breadth * 0.3] at: [length * 0.2, up * 0.3, breadth * 0.06]})
let body = m.blend([stone knuckle], 10mm)
let floor = m.box({size: [2 * length, 40mm, 2 * breadth] at: [0, -20mm, 0]})
let pebble = m.carve(body, floor, 0, {cell: 0.8mm})

handle(length, Arrow{from: [0 - length / 2, 0, 0] to: [length / 2, 0, 0]})
handle(height, Arrow{from: [0, 0, 0] to: [0, height, 0]})

object(pebble)

let slate = Material{albedo: [0.23 0.25 0.28] name: "Slate"}
let cream = Material{albedo: [0.94 0.9 0.82] name: "Cream"}
m.fill(pebble, Mix{materials: [slate cream] field: Flow{preset: @lines scale: spacing swirl: swirl seed: seed} sharp: 1})
