// A rally car that steers: kingpins, a tie rod and Ackermann arms, printed in place, in up to
// nine filaments.
use mod.fab.*

script("studio_car.cad.splash")

color("Blue", rgb: #x1a3a9e)
color("White", rgb: #xebebe5)
color("Charcoal", rgb: #x161618)
color("Clear", rgb: #x9fc4d6)
color("Orange", rgb: #xf2700f)
color("Yellow", rgb: #xfac81a)
color("Red", rgb: #xcc100d)
color("Silver", rgb: #xb3b8bf)
color("Tyre", rgb: #x1f1f1f)

// The floor prints on supports from the bed, which come away between the wheels.
place("studio_car", at: [175mm 160mm], name: "Rally car", color: "Blue", settings: {enable_support: true support_on_build_plate_only: true})
