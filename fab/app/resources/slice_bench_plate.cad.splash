// The plate Fab opens with: a parametric shelf bracket (an L section with a
// filleted inside corner and rounded edges, minus four counterbored screw
// holes) and a small bud vase (a signed distance field); slice_bench_plate.fab.splash puts
// them in two colours.
// Model frame: Y up, +Z to the front.
use mod.model.*
use mod.fab.*
let m = mod.model

// ---- Shelf bracket
let width = param(64mm, min: 20mm, max: 200mm, step: 0.5mm, label: "Width", group: "Shelf bracket")
let depth = param(46mm, min: 20mm, max: 150mm, step: 0.5mm, label: "Shelf depth", group: "Shelf bracket")
let height = param(52mm, min: 15mm, max: 200mm, step: 0.5mm, label: "Wall height", group: "Shelf bracket")
let thickness = param(6mm, min: 2mm, max: 20mm, step: 0.1mm, label: "Thickness", group: "Shelf bracket")
let fillet = param(9mm, min: 8.4mm, max: 40mm, step: 0.1mm, label: "Inside fillet", group: "Shelf bracket", kind: "radius")
let hole = param(4.6mm, min: 1mm, max: 12mm, step: 0.1mm, label: "Screw hole", group: "Shelf bracket", kind: "diameter")
let counterbore = param(8.6mm, min: 2mm, max: 20mm, step: 0.1mm, label: "Counterbore", group: "Shelf bracket", kind: "diameter")
let counterbore_depth = param(2.4mm, min: 0mm, max: 10mm, step: 0.1mm, label: "Counterbore depth", group: "Shelf bracket")
let edge_radius = param(1.2mm, min: 0mm, max: 3mm, step: 0.1mm, label: "Edge rounding", group: "Shelf bracket", kind: "radius")

// The L section in the side plane (u = Z, v = Y): the wall at the back.
let back = -depth / 2
let section = Path{from: [0, 0] segs: [
    LineTo{to: [depth / 2, 0]} RoundCorner{r: edge_radius}
    LineTo{to: [depth / 2, thickness]} RoundCorner{r: edge_radius}
    LineTo{to: [back + thickness, thickness]} RoundCorner{r: fillet}
    LineTo{to: [back + thickness, height]} RoundCorner{r: edge_radius}
    LineTo{to: [back, height]} RoundCorner{r: edge_radius}
    LineTo{to: [back, 0]} RoundCorner{r: edge_radius}
]}
let body = m.extrude({sketch: section plane: @yz height: width both: true})

// Two screw holes through the shelf (from the top), two through the wall (from the front).
let shelf_z = back + thickness + fillet + (depth - thickness - fillet) * 0.5
let wall_y = thickness + fillet + (height - thickness - fillet) * 0.55
let holes = for x in [-width * 0.27, width * 0.27] {
    m.cylinder({radius: hole / 2 height: thickness * 3 at: [x, thickness * 0.5, shelf_z]})
    m.cylinder({radius: hole / 2 height: thickness * 3 at: [x, wall_y, back + thickness * 0.5] rotate: [90°, 0, 0]})
}
let bores = for x in [-width * 0.27, width * 0.27] {
    m.cylinder({radius: counterbore / 2 height: counterbore_depth * 2 at: [x, thickness, shelf_z]})
    m.cylinder({radius: counterbore / 2 height: counterbore_depth * 2 at: [x, wall_y, back + thickness] rotate: [90°, 0, 0]})
}
let bracket = m.subtract(body, [holes bores])

// Where the bracket's parameters are dragged in the view.
handle(height, Arrow{from: [width * 0.4, 0, back + thickness * 0.5] to: [width * 0.4, height, back + thickness * 0.5]})
handle(depth, Arrow{from: [width * 0.4, thickness * 0.5, 0] to: [width * 0.4, thickness * 0.5, depth / 2]})
handle(thickness, Arrow{from: [width * 0.4, 0, depth * 0.3] to: [width * 0.4, thickness, depth * 0.3]})
handle(hole, Ring{center: [-width * 0.27, thickness, shelf_z] radius: hole / 2})
handle(counterbore, Ring{center: [width * 0.27, thickness, shelf_z] radius: counterbore / 2})

// ---- Bud vase: a belly and a neck blended, a flat foot, hollowed to its wall, open at the top.
let vase_height = param(115.0618mm, min: 30mm, max: 200mm, step: 0.5mm, label: "Height", group: "Bud vase")
let vase_belly = param(28.408mm, min: 8mm, max: 60mm, step: 0.5mm, label: "Belly", group: "Bud vase", kind: "radius")
let vase_neck = param(9.5mm, min: 3mm, max: 30mm, step: 0.5mm, label: "Neck", group: "Bud vase", kind: "radius")
let vase_wall = param(1.6mm, min: 0.8mm, max: 5mm, step: 0.1mm, label: "Wall", group: "Bud vase")
let vase_blend = param(9mm, min: 0.5mm, max: 30mm, step: 0.5mm, label: "Blend", group: "Bud vase", kind: "radius")

// The vase's own box (a field's bounds are its solid's box): its belly's widest ring with the
// skin, the skin under the foot's cut, the lip's top with the skin. The vase is cut to it.
let reach = vase_belly + vase_wall
let vase_bottom = 3mm - vase_wall
let vase_top = vase_height * 0.94 + 1.8mm + vase_wall
let vase = m.sdf({
    bounds: [[-reach, vase_bottom, -reach], [reach, vase_top, reach]]
    cell: 0.9mm
    field: fn(p) {
        let belly = sdf_ellipsoid(p - vec3(0, vase_height * 0.34, 0), vec3(vase_belly, vase_height * 0.36, vase_belly))
        let neck = sdf_cylinder(p - vec3(0, vase_height * 0.74, 0), vase_neck, vase_height * 0.42)
        let lip = sdf_torus(p - vec3(0, vase_height * 0.94, 0), vase_neck + 1.2mm, 1.8mm)
        let body = smooth_union(smooth_union(belly, neck, vase_blend), lip, vase_blend)
        let foot = sdf_box(p - vec3(0, -7mm, 0), vec3(4 * vase_belly, 20mm, 4 * vase_belly))
        let hollow = sdf_shell(sdf_difference(body, foot), vase_wall)
        let mouth = sdf_cylinder(p - vec3(0, vase_height + 4mm, 0), vase_neck - vase_wall * 0.5, 20mm)
        let within = sdf_box(p - vec3(0, (vase_bottom + vase_top) / 2, 0), vec3(2 * reach, vase_top - vase_bottom, 2 * reach))
        return sdf_intersection(sdf_difference(hollow, mouth), within)
    }
})

// Where the vase's parameters are dragged in the view.
handle(vase_height, Arrow{from: [vase_neck + 1.2mm, 0, 0] to: [vase_neck + 1.2mm, vase_height * 0.94 + 1.8mm, 0]})
handle(vase_belly, Ring{center: [0, vase_height * 0.53, 0] radius: vase_belly})
handle(vase_neck, Ring{center: [0, vase_height * 0.74, 0] radius: vase_neck})

object(bracket)
object(vase)
