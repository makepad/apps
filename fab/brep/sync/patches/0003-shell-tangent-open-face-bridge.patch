+    /// An open face maps from the opposite face use to its inset neighbour. Across
+    /// their tangent edge, pair the mapped offset with the copy on the radial mate.
+    fn shell_tangent_partner(
+        &self,
+        kernel: &Kernel,
+        original: &mut Brep,
+        edgeuse: EdgeuseId,
+        other: EdgeuseId,
+    ) -> Result<Option<EdgeuseId>> {
+        if self.extend_convex_edges || !self.inset || self.shell_faces.is_empty() {
+            return Ok(None);
+        }
+        let copied = |f: Option<FaceId>| f.is_some_and(|id| self.shell_faces.contains(&id));
+        if copied(eu::face(original, edgeuse)?) == copied(eu::face(original, other)?) {
+            return Ok(None);
+        }
+        if self.edgeuse_to_edgeuses.seconds(edgeuse).is_empty()
+            || !self.edgeuse_to_edgeuses.seconds(other).is_empty()
+        {
+            return Ok(None);
+        }
+        let Some(mate) = eu::mate(original, other)? else {
+            return Ok(None);
+        };
+        if self.edgeuse_to_edgeuses.seconds(mate).is_empty() {
+            return Ok(None);
+        }
+        if !eu2::is_tangent_sector(kernel, original, edgeuse, self.tangency_tol_degrees(), false, true)? {
+            return Ok(None);
+        }
+        Ok(Some(mate))
+    }
+
