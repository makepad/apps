// GPIO4 has an external pull-up. At 16 kHz, sixteen samples make one 1 kHz cycle.
let button = input(4, pull_none)
let tone = samples(80)
var held = false

fn setup() {
    for i in 0..80 {
        if i % 16 < 8 { tone[i] = 2048 } else { tone[i] = -2048 }
    }
}

// Refill in whole 5 ms blocks. Eight fill the 40 ms queue from empty.
fn refill() {
    for i in 0..8 {
        if speaker_free() >= 80 { play(tone, 0, 80) }
    }
}

let sound = speaker(16000, 40, fn() {
    if held { refill() }
})

let poll = every(ms(5), fn() {
    let pressed = read(button) == low
    if pressed != held {
        held = pressed
        if held {
            refill()
            speaker_on(1)
        } else {
            speaker_on(0)
        }
    }
})
