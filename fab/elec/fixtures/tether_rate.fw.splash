// Throughput over the USB tether. The host (fab-elec-mcu-flash tether <port> --rate) measures
// down, up, then both directions on the watch link's frame channel. Ethernet II frames carry
// EtherType 0x88B5 and a kind byte. 'D' is down data, 'R' is up data, 'U' starts the up flood,
// and 'X' stops it. Data frames are 1514 bytes with zeros after the kind.
let rx = bytes(1514)
let tx = bytes(1514)
var down_frames: i32 = 0
var down_bytes: i32 = 0
var up_frames: i32 = 0
var flooding: i32 = 0

fn setup() {
    // The buffers start at zero. Set the two local addresses, EtherType and kind.
    tx[0] = 2
    tx[5] = 1
    tx[6] = 2
    tx[11] = 2
    tx[12] = 136
    tx[13] = 181
    tx[14] = 82
}

let network = eth(8, fn() {
    for slot in 0..8 {
        let n = eth_recv(rx, 0)
        if n == 0 { break }
        down_frames = down_frames + 1
        down_bytes = down_bytes + n
        if n >= 15 && rx[12] == 136 && rx[13] == 181 {
            if rx[14] == 85 { flooding = 1 }
            else if rx[14] == 88 { flooding = 0 }
        }
    }
})

let send = every(ms(1), fn() {
    if flooding != 0 {
        for attempt in 0..16 {
            if eth_send(tx, 0, 1514) == 0 { break }
            up_frames = up_frames + 1
        }
    }
})

// Probes carry the low 16 bits of each frame count. The host unwraps them between reports.
let report = every(ms(1000), fn() {
    probe(1, down_frames)
    probe(2, up_frames)
})
