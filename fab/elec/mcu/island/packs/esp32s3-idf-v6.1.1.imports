# Import map v2: Espressif radio pack esp32-wifi-lib@ec08f0ce + esp-phy-lib@20f1db05 (ESP-IDF v6.1.1),
# ESP32-S3, station roots. ROM addresses from ESP-IDF v6.1.1 components/esp_rom/esp32s3/ld (Apache-2.0).
# Gates enter the kernel in ABI order. The helpers and PHY sequences are windowed island text.

gate 0 free
gate 1 phy_lock
gate 2 phy_enter
gate 3 phy_init_done
gate 4 phy_leave
gate 5 puts
gate 6 net80211_printf
gate 7 pp_printf
gate 8 phy_printf
gate 9 malloc
gate 10 event_commit
gate 11 radio_start_failed
gate 12 osi_task_delay

