let frame = bytes(1520)
let address = bytes(8)
var take: i32 = 3
var firings: i32 = 0
var frames: i32 = 0
var first: i32 = 0
var last: i32 = 0
var total: i32 = 0
var queued: i32 = 0
var mac0: i32 = 0
var mac1: i32 = 0
var mac2: i32 = 0
var mac3: i32 = 0
var mac4: i32 = 0
var mac5: i32 = 0
fn setup() {
    fill(frame, 0, 1520, 165)
    eth_mac(address, 1)
    mac0 = address[1]
    mac1 = address[2]
    mac2 = address[3]
    mac3 = address[4]
    mac4 = address[5]
    mac5 = address[6]
}
let network = eth(3, fn() {
    firings = firings + 1
    for i in 0..3 {
        if i >= take { break }
        let n = eth_recv(frame, 3)
        if n == 0 { break }
        if frames == 0 { first = n }
        last = n
        frames = frames + 1
        total = total + n
        queued = queued + eth_send(frame, 3, n)
    }
})
