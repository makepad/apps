// The networking scenarios' client (tests/net.rs): opens connection 0 at boot, sends one
// goal-byte binary message per ready period, checks every byte it receives against the pattern it
// sends, and reports what it can see through probes:
// 1-3 the link and its code and detail, 4-6 the state and its code and detail, 7 the epoch and
// 8 the bytes of a partly read message its end dropped, 9-13 each whole message received (size
// low and high, wrong bytes, kind, short sends so far), 14-15 a close and a reopen.
let rx = bytes(1600)
let tx = bytes(1500)
var goal: i32 = 0
var step: i32 = 1600
var slow: i32 = 0
var close_after: i32 = 0
var reopen: i32 = 0
var sent: i32 = 0
var short: i32 = 0
var link_seen: i32 = -1
var state_seen: i32 = -1
var epoch_seen: i32 = 0
var got: i32 = 0
var bad: i32 = 0
var messages: i32 = 0

fn setup() {
    for i in 0..1500 {
        tx[i] = ((i * 7) + 3) & 255
    }
    net_open(0)
}

fn report() {
    let link = net_link()
    if link != link_seen {
        link_seen = link
        probe(1, link)
        probe(2, net_link_error())
        probe(3, net_link_detail())
    }
    let epoch = net_epoch(0)
    if epoch != epoch_seen {
        epoch_seen = epoch
        probe(7, epoch)
        probe(8, got)
        got = 0
        bad = 0
        sent = 0
    }
    let state = net_state(0)
    if state != state_seen {
        state_seen = state
        probe(4, state)
        probe(5, net_error(0))
        probe(6, net_detail(0))
    }
}

fn send_more() {
    for k in 0..256 {
        if net_state(0) != net_ready {
            break
        }
        if sent >= goal {
            break
        }
        let off = sent % 1500
        var n: i32 = goal - sent
        if n > 1500 - off {
            n = 1500 - off
        }
        var flags: i32 = net_binary
        if sent + n < goal {
            flags = net_binary | net_more
        }
        let took = net_send(0, tx, off, n, flags)
        sent = sent + took
        if took < n {
            short = short + 1
            break
        }
    }
}

fn read_some(reads: i32) {
    for k in 0..64 {
        if k >= reads {
            break
        }
        let left = net_left(0)
        if left == 0 {
            break
        }
        let kind = net_kind(0)
        let n = net_recv(0, rx, 0, step)
        if n == 0 {
            break
        }
        for i in 0..1600 {
            if i >= n {
                break
            }
            if rx[i] != (((((got + i) % 1500) * 7) + 3) & 255) {
                bad = bad + 1
            }
        }
        got = got + n
        if n == left {
            messages = messages + 1
            probe(9, got & 65535)
            probe(10, got >> 16)
            probe(11, bad)
            probe(12, kind)
            probe(13, short)
            got = 0
            bad = 0
            if close_after > 0 {
                if messages >= close_after {
                    probe(14, net_close(0))
                    if reopen != 0 {
                        probe(15, net_open(0))
                    }
                }
            }
        }
    }
}

let conn = net(net_websocket, 4, 4096, fn() {
    report()
    if slow == 0 {
        read_some(64)
    }
    send_more()
    report()
})

let tick = every(ms(10), fn() {
    if slow != 0 {
        read_some(1)
        report()
    }
})
