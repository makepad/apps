use mod.motion.*
use mod.post
use mod.motion.modules.film.*
use mod.motion.modules.kinetic.*

// The motion deck's look: the sleek language of the makepad deck (deep blue-black field, warm
// off-white type, one soft cyan for structure, an apricot that tints at most one word, slowly).
// Every slide draws `ground` under its layers and `chrome` (folio, heading, the one quiet line,
// the syntax label) over them, so the frame is identical from slide to slide.
let INK = #090a0d
let INK2 = #14161b
let BONE = #f0ede6
let GRAPHITE = #3d4048
let ASH = #8d919a
let COOL = #74d4f2
let HOT = #f0a27a
let SEA = #5fb9a6

let TITLE = Font{family: "Roboto Flex" weight: 600}
let TEXT = Font{family: "Roboto Flex" weight: 420}
let MONO = Font{family: "JetBrains Mono" weight: 400}
let SERIF = Font{family: "Cormorant Garamond" weight: 400}

// Restrained light: no aberration, a faint bloom, almost no grain, a soft vignette.
let POST = {ca: 0 bloom: 0.15 threshold: 1.0 knee: 0.5 radius: 0.8 halation: 0.04 vignette: 0.28 grain: 0.008}

// The stage the demos sit on: x 96..1824, y 300..940.
let LEFT = 96.0
let RIGHT = 1824.0

let hot_ink = fn(amount) { mix(BONE, HOT, clamp(amount, 0.0, 1.0)) }

// One soft pool of light drifting over a minute; opaque stops only (no transparent washes).
let ground = fn(c, t, ambient) {
    c.gradient([[0, 0], [1920, 0], [1920, 1080], [0, 1080]],
        {radial: [960 + 40 * sin(ambient * 0.05), 470 + 18 * cos(ambient * 0.04), 40, 1180]
            stops: [[0, INK2], [1, INK]]}, 0.9)
}

// The slide number in the accent and the chapter in sentence case, top left.
let folio = fn(c, t, no, chapter) {
    glide_text(c, no, LEFT, 92, t, 0.15, {font: MONO px: 20 color: COOL alpha: 0.75 dur: 1.2 rise: 10})
    glide_text(c, chapter, LEFT + 44, 92, t, 0.25, {font: TEXT px: 22 color: ASH alpha: 0.85 dur: 1.2 rise: 10})
}

// A sentence-case title and its one-line explanation, gliding in.
let heading = fn(c, t, title, line) {
    glide_text(c, title, LEFT, 196, t, 0.3, {font: TITLE px: 64 color: BONE dur: 1.4 rise: 14})
    glide_text(c, line, LEFT, 252, t, 0.55, {font: TEXT px: 28 color: ASH dur: 1.4 rise: 10})
}

// The syntax that makes the picture, bottom right, in mono: what an author writes.
let syntax = fn(c, t, t0, text) {
    glide_text(c, text, RIGHT, 1010, t, t0, {font: MONO px: 22 color: ASH alpha: 0.9 align: @right dur: 1.2 rise: 8})
}

// A small label in the demo area (sentence case, quiet), gliding in at t0.
let label = fn(c, t, t0, text, x, y, o) {
    glide_text(c, text, x, y, t, t0, o{font: o.font ?? TEXT px: o.px ?? 24 color: o.color ?? ASH dur: o.dur ?? 1.2 rise: o.rise ?? 10})
}

// The film chain with its grain seeded on the live clock (it keeps moving while a beat holds).
let post_chain = fn(o) {
    let passes = film_post(o)
    passes[passes.len() - 1] = post.Pass{
        at: @final map: true reads: [@color]
        uniforms: {amount: o.grain phase: fn(t) { floor(live() * 60.0) }}
        pixel: fn() -> vec4 {
            let c = self.color.sample(self.uv())
            let px = floor(self.uv() * self.size())
            let cell = floor(px / max(self.size().y / 1080.0, 1.0))
            let seed = vec2(self.hash(vec2(self.phase * 0.618 + 0.5, 1.7)),
                self.hash(vec2(self.phase * 0.618 + 2.2, 2.07))) * 1000.0
            let g1 = self.hash(cell + seed) - 0.5
            let g2 = self.hash(floor(cell / 2.0) + seed.yx) - 0.5
            let l = clamp(self.luma(c.xyz), 0.0, 1.0)
            let k = self.amount * (0.55 + 1.2 * l * (1.0 - l))
            let dn = (self.hash(px * 1.37 + seed * 0.1) - 0.5) / 255.0
            let n = (0.6 * g1 + 0.4 * g2) * k + dn
            return vec4(clamp(c.xyz + vec3(n, n, n), vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)), c.w)
        }
    }
    return passes
}

{INK: INK INK2: INK2 BONE: BONE GRAPHITE: GRAPHITE ASH: ASH COOL: COOL HOT: HOT SEA: SEA
    TITLE: TITLE TEXT: TEXT MONO: MONO SERIF: SERIF POST: POST LEFT: LEFT RIGHT: RIGHT
    hot_ink: hot_ink ground: ground folio: folio heading: heading syntax: syntax label: label
    post_chain: post_chain}
