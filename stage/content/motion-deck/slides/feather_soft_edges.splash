use mod.motion.*

// Shape & paths 1: feathering. A specimen sheet: four subjects that used to break soft edges
// (a concave star, a ring with a hole, an open stroke, a word) in three rows, one per
// feather_side. The feather breathes on the live clock, so the held slide keeps showing it.
let look = import("shared/motion_deck_look")

let STAR = "M80 0 L100 52.5 L156.1 55.3 L112.3 90.5 L127 144.7 L80 114 L33 144.7 L47.7 90.5 L3.9 55.3 L60 52.5 Z"
// The inner circle runs the other way round: a hole under the non-zero rule.
let RING = "M2 80 A78 78 0 1 0 158 80 A78 78 0 1 0 2 80 Z M40 80 A40 40 0 1 1 120 80 A40 40 0 1 1 40 80 Z"
let WAVE = "M0 130 C40 0 80 0 100 70 S150 160 170 30"
let COLUMNS = [470.0, 850.0, 1230.0, 1610.0]
let ROWS = [
    {side: @both y: 340.0 at: 0.9 name: "@both" note: "half on the edge"},
    {side: @inner y: 540.0 at: 1.1 name: "@inner" note: "inside only"},
    {side: @outer y: 740.0 at: 1.3 name: "@outer" note: "crisp, with a halo"}
]
// 3 to 22 units and back over about eight seconds of live time.
let breathe = fn(t) { 3.0 + 19.0 * (0.5 - 0.5 * cos(live() * 0.8)) }

let row_layers = fn(row) {
    let enter = tween(0, 1, row.at, row.at + 1.4, @ease_in_out_cubic)
    let rise = tween(14, 0, row.at, row.at + 1.4, @ease_in_out_cubic)
    return [
        Path{name: "star " + row.name svg: STAR fill: look.BONE at: vec2(COLUMNS[0] - 80, row.y)
            feather: breathe feather_side: row.side opacity: enter y: rise}
        Path{name: "ring " + row.name svg: RING fill: look.COOL at: vec2(COLUMNS[1] - 80, row.y)
            feather: breathe feather_side: row.side opacity: enter y: rise}
        Path{name: "stroke " + row.name svg: WAVE stroke: look.BONE width: 16 cap: @round at: vec2(COLUMNS[2] - 85, row.y)
            feather: breathe feather_side: row.side opacity: enter y: rise}
        Text{name: "word " + row.name text: "soft" font: look.TITLE size: 96 color: look.BONE align: @center
            at: vec2(COLUMNS[3], row.y + 20) feather: breathe feather_side: row.side opacity: enter y: rise}
    ]
}

let build_layers = fn() {
    let layers = [Draw2D{name: "ground" size: vec2(1920, 1080) draw: fn(c, t, edit) { look.ground(c, t, live()) }}]
    for row in ROWS {
        for layer in row_layers(row) { layers.push(layer) }
    }
    layers.push(Draw2D{name: "chrome" size: vec2(1920, 1080) draw: fn(c, t, edit) {
        look.folio(c, t, "03", "Shape and paths")
        look.heading(c, t, "Soft edges, exactly.", "Feather any fill, stroke or letter. Concave shapes and holes stay right.")
        for row in ROWS {
            look.label(c, t, row.at + 0.2, row.name, look.LEFT, row.y + 72, {font: look.MONO px: 24 color: look.COOL})
            look.label(c, t, row.at + 0.35, row.note, look.LEFT, row.y + 106, {px: 22})
        }
        let names = ["concave", "a hole", "an open stroke", "type"]
        for i in 0..4 {
            look.label(c, t, 1.7 + 0.1 * i, names[i], COLUMNS[i], 960, {px: 22 align: @center})
        }
        look.syntax(c, t, 2.0, "feather: 24   feather_side: @both | @inner | @outer")
    }})
    return layers
}

Motion{
    label: "Soft edges, exactly"
    size: vec2(1920, 1080)
    duration: 4.0
    fps: 60
    color: @hdr
    background: look.INK
    layers: build_layers()
    post: look.post_chain(look.POST)
}
