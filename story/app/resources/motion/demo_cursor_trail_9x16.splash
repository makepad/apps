use mod.motion.*
// CURSOR TRAIL, 9:16 — the portrait cut of demo_cursor_trail, a longer
// vertical move up to a control in the top bar. Original notes follow.
// CURSOR TRAIL — a stand-in pointer glides from one place to another along
// a smooth curve through three points (ease_in_out_cubic: it accelerates
// off the start and brakes onto the target, like a hand), leaving a comet
// trail whose tail chases the head. On arrival it clicks: the arrow dips to
// 88% and a ripple rings out from the tip. Transparent overlay; over a
// recording that already shows a real cursor, keep only the ripple.
// Why: a curved, eased path reads as human; a straight linear one reads as
// a robot. The ripple marks the exact frame of the click.
Motion{
    label: "Cursor trail and click 9:16"
    brief: "A pointer gliding along a curve with a comet trail, ending in a click ripple; portrait."
    tags: ["demo", "overlay", "cursor", "click", "pointer", "product", "9:16"]
    size: vec2(1080, 1920) duration: 3.0
    inputs: {
        from: input(@vec2, vec2(360, 1150), "Start of the move (the arrow's tip), px")
        via: input(@vec2, vec2(820, 620), "A point the curve passes through, px")
        to: input(@vec2, vec2(950, 60), "Where it clicks, px")
        trail: input(@color, #ff5c39, "Trail and ripple")
        arrow: input(@color, #f4f7fa, "Arrow fill")
        outline: input(@color, #0b0d12, "Arrow outline")
    }
    layers: [
        Path{points: [in(@from), in(@via), in(@to)] smooth: true stroke: in(@trail) width: 10 opacity: 0.7
             trim_end: tween(0, 1, 0.2, 1.6, @ease_in_out_cubic)
             trim_start: tween(0, 1, 0.45, 1.75, @ease_in_out_cubic)}
        Group{at: in(@to) layers: [
            Ellipse{at: vec2(-75, -75) size: vec2(150, 150) stroke: in(@trail) width: 4
                    scale: tween(0.07, 1.0, 1.65, 2.4, @ease_out_expo)
                    opacity: keys([1.65, 0.0], [1.67, 1.0], [2.4, 0.0, @ease_out_cubic])}
        ]}
        Path{at: along([in(@from), in(@via), in(@to)], tween(0, 1, 0.2, 1.6, @ease_in_out_cubic)) anchor: vec2(0, 0)
             svg: "M 0 0 L 0 44 L 11 33 L 19 52 L 27 48 L 19 30 L 34 30 Z"
             fill: in(@arrow) stroke: in(@outline) width: 3 join: @round
             scale: keys([1.6, 1.0], [1.66, 0.88, @ease_out_cubic], [1.9, 1.0, @ease_out_back])
             opacity: keys([0.0, 0], [0.2, 1, @ease_out_cubic], [2.6, 1], [3.0, 0, @ease_in_cubic])}
    ]
}
