use mod.motion.*
// END CARD, 9:16 — the portrait cut of end_card_cta: the stack (mark, name,
// tagline, button, URL) is centred on the safe column and ends above the
// bottom band, so the button is never under the platform's own UI.
// Why: on a phone the CTA must be tappable-looking and unobstructed; the
// safe area decides where the stack ends, the stack decides the rest.
Motion{
    label: "End card with CTA 9:16"
    brief: "Mark, product name, tagline, a pressed call-to-action button and a URL; portrait."
    tags: ["end-card", "cta", "outro", "launch", "9:16"]
    size: vec2(1080, 1920) duration: 5.0
    inputs: {
        product: input(@text, "Notes", "Product name")
        tagline: input(@text, "Write it down. Find it instantly.", "One line (wraps to two)")
        cta: input(@text, "Try it free  →", "Button label")
        url: input(@text, "notes.example.com", "Address under the button")
        accent: input(@color, #ff5c39, "Mark, glow and button")
        ink: input(@color, #f4f7fa, "Name colour")
        muted: input(@color, #a6b1bd, "Tagline and URL")
        background: input(@color, #0b0d12, "Ground")
    }
    layers: [
        Rect{size: vec2(1080, 1920) fill: in(@background)}
        Ellipse{at: vec2(70, 200) size: vec2(900, 800) fill: in(@accent) feather: 420
                opacity: tween(0, 0.22, 0.0, 1.5, @ease_out_cubic) scale: tween(0.8, 1.1, 0.0, 5.0, @ease_out_cubic)}
        Rect{at: vec2(454, 380) size: vec2(132, 132) radius: 36 fill: in(@accent)
             scale: tween(0, 1, 0.1, 0.9, spring(260, 18)) rotate: tween(-30, 0, 0.1, 0.9, spring(260, 20))}
        Path{at: vec2(520, 446) anchor: vec2(0, 0) svg: "M -30 -26 L 30 -26 M -30 0 L 30 0 M -30 26 L 12 26" stroke: in(@background) width: 11
             trim_end: tween(0, 1, 0.5, 1.0, @ease_out_cubic)}
        Text{text: in(@product) font: Font{family: "Inter" weight: 800} size: 120 tracking: -0.035 color: in(@ink)
             at: vec2(520, 560) wrap: 840 align: @center
             y: tween(40, 0, 0.45, 1.3, @ease_out_quint) opacity: tween(0, 1, 0.45, 0.85, @ease_out_cubic)}
        Text{text: in(@tagline) font: Font{family: "Inter"} size: 46 color: in(@muted) line_height: 1.3
             at: vec2(520, 716) wrap: 720 align: @center
             y: tween(24, 0, 0.65, 1.5, @ease_out_quint) opacity: tween(0, 1, 0.65, 1.05, @ease_out_cubic)}
        Ellipse{at: vec2(310, 895) size: vec2(420, 120) stroke: in(@accent) width: 3
                scale: tween(1.0, 1.8, 2.1, 2.9, @ease_out_expo)
                opacity: keys([0.0, 0.0], [2.1, 0.0], [2.12, 0.9], [2.9, 0.0, @ease_out_cubic])}
        Text{text: in(@cta) font: Font{family: "Inter" weight: 700} size: 48 color: in(@background)
             at: vec2(520, 926) wrap: 840 align: @center
             plate: in(@accent) plate_pad: vec2(60, 28) plate_radius: 64
             scale: keys([0.0, 0.0], [1.1, 0.0], [1.7, 1.0, @ease_out_back], [2.0, 1.0], [2.06, 0.94, @ease_out_cubic], [2.4, 1.0, @ease_out_back])
             opacity: tween(0, 1, 1.1, 1.3, @ease_out_cubic)}
        Text{text: in(@url) font: Font{family: "Inter" weight: 500} size: 34 color: in(@muted)
             at: vec2(520, 1090) wrap: 840 align: @center opacity: tween(0, 1, 2.4, 3.0, @ease_out_cubic)}
    ]
}
