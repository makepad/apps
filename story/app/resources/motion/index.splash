// The bundled motion library (D2): every document with its
// portrait cut and its category, in the order the library should list them.
// Each file is a complete Motion document; `landscape` is 1920×1080 and
// `portrait` 1080×1920 (the same design re-set for the Reels/TikTok/Shorts
// safe area). Seed them into the library as AssetKind::Motion with the
// document's own `tags` plus `category`.
[
    {name: "type_word_punch" category: @kinetic_type landscape: "type_word_punch.splash" portrait: "type_word_punch_9x16.splash"}
    {name: "type_letter_cascade" category: @kinetic_type landscape: "type_letter_cascade.splash" portrait: "type_letter_cascade_9x16.splash"}
    {name: "type_split_reveal" category: @kinetic_type landscape: "type_split_reveal.splash" portrait: "type_split_reveal_9x16.splash"}
    {name: "type_mask_wipe" category: @kinetic_type landscape: "type_mask_wipe.splash" portrait: "type_mask_wipe_9x16.splash"}
    {name: "type_typewriter" category: @kinetic_type landscape: "type_typewriter.splash" portrait: "type_typewriter_9x16.splash"}
    {name: "type_count_up" category: @kinetic_type landscape: "type_count_up.splash" portrait: "type_count_up_9x16.splash"}
    {name: "type_quote_card" category: @kinetic_type landscape: "type_quote_card.splash" portrait: "type_quote_card_9x16.splash"}
    {name: "sync_voice_karaoke" category: @sync landscape: "sync_voice_karaoke.splash" portrait: "sync_voice_karaoke_9x16.splash"}
    {name: "sync_voice_word_punch" category: @sync landscape: "sync_voice_word_punch.splash" portrait: "sync_voice_word_punch_9x16.splash"}
    {name: "sync_beat_words" category: @sync landscape: "sync_beat_words.splash" portrait: "sync_beat_words_9x16.splash"}
    {name: "sync_beat_pulse_title" category: @sync landscape: "sync_beat_pulse_title.splash" portrait: "sync_beat_pulse_title_9x16.splash"}
