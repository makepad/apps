use mod.motion.*
// CLEAN LOWER THIRD — no box to outgrow: an accent bar grows down, the
// name slides out from behind it, the role follows 0.1 s later, all over a
// soft bottom-left scrim that keeps white type legible on any footage.
// Transparent: drop it over video.
// Why: the bar is the only shape, so any name length works; sliding out
// from behind the bar (a mask) reads as the name being "unfiled".
Motion{
    label: "Clean lower third"
    brief: "Name and role beside a growing accent bar, over a soft scrim; fits any name length."
    tags: ["lower-third", "clean", "name", "overlay", "interview"]
    duration: 6.0
    inputs: {
        name: input(@text, "Ada Moreno", "Person's name")
        role: input(@text, "Head of Product, Lumen", "Role or place")
        ink: input(@color, #f4f7fa, "Name colour")
        muted: input(@color, #d6dee6, "Role colour")
        accent: input(@color, #ff5c39, "Bar colour")
    }
    layers: [
        Ellipse{at: vec2(-450, 710) size: vec2(1500, 620) fill: #000000 feather: 260
                opacity: keys([0.0, 0], [0.6, 0.55, @ease_out_cubic], [5.4, 0.55], [6.0, 0, @ease_in_cubic])}
        Rect{at: vec2(160, 820) size: vec2(8, 124) radius: 4 fill: in(@accent) anchor: vec2(0.5, 0)
             scale: keys([0.1, vec2(1, 0)], [0.6, vec2(1, 1), @ease_out_expo], [5.45, vec2(1, 1)], [5.8, vec2(1, 0), @ease_in_expo])}
        Group{
            mask: Rect{at: vec2(176, 780) size: vec2(1600, 220)}
            layers: [
                Text{text: in(@name) font: Font{family: "Inter" weight: 700} size: 60 tracking: -0.015 color: in(@ink) at: vec2(200, 808)
                     x: keys([0.3, -60], [1.0, 0, @ease_out_expo], [5.25, 0], [5.65, -60, @ease_in_expo])
                     opacity: keys([0.3, 0], [0.6, 1, @ease_out_cubic], [5.35, 1], [5.65, 0, @ease_in_cubic])}
                Text{text: in(@role) font: Font{family: "Inter" weight: 500} size: 34 color: in(@muted) at: vec2(200, 890)
                     x: keys([0.4, -60], [1.1, 0, @ease_out_expo], [5.2, 0], [5.6, -60, @ease_in_expo])
                     opacity: keys([0.4, 0], [0.7, 1, @ease_out_cubic], [5.3, 1], [5.6, 0, @ease_in_cubic])}
            ]
        }
    ]
}
