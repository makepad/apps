use mod.motion.*
// EDITORIAL LOWER THIRD, 9:16 — the portrait cut of lower_third_editorial:
// hairline, italic name and small-caps role on the safe column's left
// edge, finishing above the bottom band. Transparent overlay.
// Why: understatement scales down well — only the position changes.
Motion{
    label: "Editorial lower third 9:16"
    brief: "An italic name on a hairline rule with a small-caps role; portrait."
    tags: ["lower-third", "editorial", "name", "overlay", "documentary", "9:16"]
    size: vec2(1080, 1920) duration: 6.0
    inputs: {
        name: input(@text, "Ada Moreno", "Person's name")
        role: input(@text, "HEAD OF PRODUCT, LUMEN", "Role, set in caps")
        ink: input(@color, #f4f7fa, "Name colour")
        muted: input(@color, #d6dee6, "Role colour")
        rule: input(@color, #f4f7face, "Hairline colour")
    }
    layers: [
        Ellipse{at: vec2(-400, 920) size: vec2(1300, 520) fill: #000000 feather: 240
                opacity: keys([0.0, 0], [0.8, 0.45, @ease_out_cubic], [5.2, 0.45], [6.0, 0, @ease_in_cubic])}
        Rect{at: vec2(100, 1170) size: keys([0.0, vec2(0, 2)], [1.0, vec2(480, 2), @ease_in_out_quint], [5.2, vec2(480, 2)], [5.9, vec2(0, 2), @ease_in_out_quint])
             fill: in(@rule)}
        Text{text: in(@name) font: Font{family: "IBM Plex Sans" italic: true} size: 76 color: in(@ink) at: vec2(100, 1066)
             opacity: keys([0.5, 0], [1.2, 1, @ease_out_cubic], [5.0, 1], [5.5, 0, @ease_in_cubic])
             y: tween(12, 0, 0.5, 1.4, @ease_out_quint)}
        Text{text: in(@role) font: Font{family: "Inter" weight: 600} size: 24 tracking: 0.24 color: in(@muted) at: vec2(100, 1190)
             opacity: keys([0.8, 0], [1.4, 1, @ease_out_cubic], [4.9, 1], [5.4, 0, @ease_in_cubic])
             y: tween(-8, 0, 0.8, 1.6, @ease_out_quint)}
    ]
}
