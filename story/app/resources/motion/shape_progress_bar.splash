use mod.motion.*
// PROGRESS BAR — a labelled bar that fills to a value on ease_in_out_cubic
// while the percentage counts along with it (same timing, same ease, so
// number and bar never disagree). A soft glow rides the fill edge and
// fades once it stops; ticks at quarters give the scale.
// Why: the S-curve reads as "working" (start, cruise, settle) where a
// linear fill reads as a loading spinner.
let ticks = []
for i in 0..5 {
    ticks.push(Rect{at: vec2(359 + i * 300, 540) size: vec2(2, 14) fill: in(@muted)
                    opacity: tween(0, 0.6, 0.3 + i * 0.05, 0.7 + i * 0.05, @ease_out_cubic)})
}
Motion{
    label: "Progress bar"
    brief: "A labelled progress bar filling to a value with a synced percentage."
    tags: ["progress", "data", "bar", "ui", "shape"]
    duration: 4.0
    inputs: {
        value: input(@number, 72, "Percent, 0–100")
        label: input(@text, "Rendering your video", "What is progressing")
        accent: input(@color, #ff5c39, "Fill and percentage")
        ink: input(@color, #f4f7fa, "Label")
        muted: input(@color, #8e9aa7, "Ticks")
        track: input(@color, #ffffff1a, "Empty track")
        background: input(@color, #0b0d12, "Ground")
    }
    layers: [
        Rect{size: vec2(1920, 1080) fill: in(@background)}
        Group{
            y: keys([0.0, 30], [0.6, 0, @ease_out_expo], [3.6, 0], [4.0, -20, @ease_in_cubic])
            opacity: keys([0.0, 0], [0.35, 1, @ease_out_cubic], [3.6, 1], [4.0, 0, @ease_in_cubic])
            layers: [
                Text{text: in(@label) font: Font{family: "Inter" weight: 600} size: 48 color: in(@ink) at: vec2(360, 392)}
                Text{number: tween(0, in(@value), 0.4, 2.4, @ease_in_out_cubic) suffix: "%" tabular: true
                     font: Font{family: "Inter" weight: 600} size: 48 color: in(@accent) at: vec2(1560, 392) wrap: 400 align: @right}
                Rect{at: vec2(360, 500) size: vec2(1200, 16) radius: 8 fill: in(@track)}
                Rect{at: vec2(360, 500) size: tween(vec2(16, 16), vec2(in(@value) * 12, 16), 0.4, 2.4, @ease_in_out_cubic) radius: 8 fill: in(@accent)}
                Ellipse{at: tween(vec2(346, 486), vec2(338 + in(@value) * 12, 486), 0.4, 2.4, @ease_in_out_cubic) size: vec2(44, 44)
                        fill: in(@accent) feather: 24 opacity: keys([0.0, 0.0], [0.4, 0.9], [2.4, 0.9], [2.9, 0.0, @ease_out_cubic])}
                Group{layers: ticks}
            ]
        }
    ]
}
