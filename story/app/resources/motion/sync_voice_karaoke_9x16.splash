use mod.motion.*
// VOICE KARAOKE, 9:16 — the portrait cut of sync_voice_karaoke: the line
// wraps in the safe column at 104 px. Original notes follow.
// VOICE KARAOKE — speech-synced kinetic type from the voiceover's own word
// timings. The line being spoken sits large in the middle;
// words already said turn ink, the word being said is lit in the accent
// and pops 25% as it starts, words to come wait at 35%. When the voice
// moves to its next line, the next line replaces this one.
// Why: the viewer reads along at the speaker's pace, so emphasis in the
// voice becomes emphasis on screen for free; re-timing the voice re-syncs
// the graphic with no edit.
// Host: bind @vo to the edit's voiceover node (Graphic params).
Motion{
    label: "Voice karaoke 9:16"
    brief: "The spoken line, large, lighting and popping each word as the voiceover says it; portrait."
    tags: ["kinetic-type", "voice-sync", "karaoke", "captions", "speech", "9:16"]
    size: vec2(1080, 1920) duration: 4.8
    inputs: {
        ink: input(@color, #f4f7fa, "Spoken words")
        accent: input(@color, #ff5c39, "The word being said")
        background: input(@color, #0b0d12, "Ground; #00000000 over footage")
    }
    layers: [
        Rect{size: vec2(1080, 1920) fill: in(@background)}
        Text{source: voice(@vo) show: @line highlight: @active highlight_color: in(@accent) pop: @on_word
             font: Font{family: "Inter" weight: 800} size: 104 tracking: -0.03 line_height: 1.1
             at: vec2(520, 620) wrap: 840 align: @center
             color: fn(t, i, edit) { if voice(@vo).progress(i, edit) < 0 { rgba(0.957, 0.969, 0.98, 0.35) } else { in(@ink) } }}
    ]
}
