use mod.motion.*
// CLEAN TITLE, 9:16 — the portrait cut of title_clean: the headline wraps
// to two or three lines at 104 px inside the safe column, the block is
// centred on the safe area's centre (y 760), the subline wraps under it.
// Why: same rhythm as the 16:9 title, re-set for a narrow measure — the
// type gets smaller, the stack gets taller, the timing stays.
Motion{
    label: "Clean title 9:16"
    brief: "Centred kicker, headline and subline, rising in word by word; portrait."
    tags: ["title", "clean", "chapter", "intro", "9:16"]
    size: vec2(1080, 1920) duration: 5.0
    inputs: {
        kicker: input(@text, "CHAPTER 01", "Small caps line above")
        headline: input(@text, "Everything in one place", "Up to about six words")
        subline: input(@text, "Notes, tasks and files, finally together.", "One sentence under the headline")
        ink: input(@color, #f4f7fa, "Headline colour")
        muted: input(@color, #a6b1bd, "Subline colour")
        accent: input(@color, #ff5c39, "Kicker and rule")
        background: input(@color, #0b0d12, "Ground")
    }
    layers: [
        Rect{size: vec2(1080, 1920) fill: in(@background)}
        Group{
            y: tween(0, -40, 4.55, 5.0, @ease_in_cubic)
            opacity: tween(1, 0, 4.55, 5.0, @ease_in_cubic)
            layers: [
                Text{text: in(@kicker) font: Font{family: "Inter" weight: 600} size: 30 tracking: 0.28 color: in(@accent)
                     at: vec2(520, 530) wrap: 840 align: @center
                     opacity: tween(0, 1, 0.1, 0.6, @ease_out_cubic) y: tween(12, 0, 0.1, 0.8, @ease_out_quint)}
                Text{text: in(@headline) font: Font{family: "Inter" weight: 700} size: 104 tracking: -0.03 color: in(@ink) line_height: 1.1
                     at: vec2(520, 596) wrap: 840 align: @center
                     by: @word stagger: 0.08
                     y: tween(48, 0, 0.3, 1.2, @ease_out_quint)
                     opacity: tween(0, 1, 0.3, 0.7, @ease_out_cubic)}
                Text{text: in(@subline) font: Font{family: "Inter"} size: 44 color: in(@muted) line_height: 1.3
                     at: vec2(520, 870) wrap: 760 align: @center
                     y: tween(24, 0, 0.8, 1.6, @ease_out_quint)
                     opacity: tween(0, 1, 0.8, 1.3, @ease_out_cubic)}
                Rect{at: vec2(480, 1030) size: vec2(80, 4) radius: 2 fill: in(@accent)
                     scale: tween(vec2(0, 1), vec2(1, 1), 1.1, 1.8, @ease_out_expo)}
            ]
        }
    ]
}
