use mod.motion.*
// EDITORIAL TITLE, 9:16 — the portrait cut of title_editorial: rules at the
// top and bottom of the safe area, the italic headline wraps to four lines
// at 100 px, and the body sits under it with its accent rule to its left.
// Why: the magazine grid survives the narrow frame by stacking the columns
// instead of placing them side by side.
Motion{
    label: "Editorial title 9:16"
    brief: "A magazine-style opener: rules, numbered kicker, large italic headline and body; portrait."
    tags: ["title", "editorial", "magazine", "elegant", "9:16"]
    size: vec2(1080, 1920) duration: 6.0
    inputs: {
        issue: input(@text, "No. 04", "Number or date, top left")
        section: input(@text, "FIELD NOTES", "Section name, top right")
        headline: input(@text, "The quiet craft of making things move", "Up to about eight words")
        body: input(@text, "Motion is timing first, drawing second. Here is how we think about both.", "Two short sentences")
        paper: input(@color, #f3efe6, "Ground")
        ink: input(@color, #1b1d22, "Type and rules")
        muted: input(@color, #6b6f77, "Body colour")
        accent: input(@color, #ff5c39, "Kicker and body rule")
    }
    layers: [
        Rect{size: vec2(1080, 1920) fill: in(@paper)}
        Group{
            opacity: tween(1, 0, 5.5, 6.0, @ease_in_cubic)
            layers: [
                Rect{at: vec2(100, 300) size: tween(vec2(0, 2), vec2(840, 2), 0.0, 1.2, @ease_in_out_quint) fill: in(@ink)}
                Rect{at: vec2(100, 1230) size: tween(vec2(0, 2), vec2(840, 2), 0.2, 1.4, @ease_in_out_quint) fill: in(@ink)}
                Text{text: in(@issue) font: Font{family: "IBM Plex Sans" italic: true} size: 34 color: in(@accent)
                     at: vec2(100, 326) opacity: tween(0, 1, 0.6, 1.1, @ease_out_cubic)}
                Text{text: in(@section) font: Font{family: "Inter" weight: 600} size: 24 tracking: 0.28 color: in(@ink)
                     at: vec2(940, 334) wrap: 500 align: @right opacity: tween(0, 1, 0.7, 1.2, @ease_out_cubic)}
                Text{text: in(@headline) font: Font{family: "IBM Plex Sans" italic: true} size: 100 color: in(@ink)
                     line_height: 1.08 tracking: -0.02 wrap: 820 at: vec2(100, 440)
                     by: @word stagger: 0.07
                     opacity: tween(0, 1, 0.8, 1.5, @ease_out_cubic)
                     blur: tween(8, 0, 0.8, 1.5, @ease_out_cubic)
                     y: tween(20, 0, 0.8, 1.7, @ease_out_quint)}
                Rect{at: vec2(100, 960) size: vec2(2, 160) fill: in(@accent)
                     anchor: vec2(0.5, 0) scale: tween(vec2(1, 0), vec2(1, 1), 1.6, 2.4, @ease_out_quint)}
                Text{text: in(@body) font: Font{family: "Inter"} size: 34 color: in(@muted) line_height: 1.45
                     wrap: 640 at: vec2(130, 956)
                     opacity: tween(0, 1, 1.8, 2.6, @ease_out_cubic) y: tween(14, 0, 1.8, 2.8, @ease_out_quint)}
            ]
        }
    ]
}
