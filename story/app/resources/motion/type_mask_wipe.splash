use mod.motion.*
// MASK WIPE — each line is uncovered left to right by a soft-edged mask
// while it eases 40 px into place. An accent copy of the line is uncovered
// 0.12 s ahead of the ink copy, so every letter flashes accent at the wipe
// front and settles to ink: a coloured leading edge that fits any text
// length. Line 2 follows 0.15 s later; the exit is a quick wipe off right.
// Why: the eye follows the wipe front, so reading speed is set by the
// animation; the colour lag makes a flat wipe feel lit.
Motion{
    label: "Mask wipe"
    brief: "Two left-aligned lines uncovered by a soft wipe with an accent leading edge."
    tags: ["kinetic-type", "headline", "clean", "mask", "wipe"]
    duration: 4.5
    inputs: {
        line1: input(@text, "Say less.", "First line, about 18 characters")
        line2: input(@text, "Show more.", "Second line (set in the accent)")
        ink: input(@color, #f4f7fa, "Type colour")
        accent: input(@color, #ff5c39, "Accent colour")
        background: input(@color, #0b0d12, "Ground")
    }
    layers: [
        Rect{size: vec2(1920, 1080) fill: in(@background)}
        // line 1: the accent copy first, the ink copy 0.12 s behind it
        Group{
            mask: Rect{at: vec2(100, 330) size: tween(vec2(0, 190), vec2(1500, 190), 0.2, 1.1, @ease_in_out_cubic) feather: 60
                       x: tween(0, 1500, 3.8, 4.3, @ease_in_cubic)}
            layers: [Text{text: in(@line1) font: Font{family: "Inter" weight: 800} size: 150 tracking: -0.035 color: in(@accent)
                          at: vec2(160, 340) x: tween(40, 0, 0.2, 1.3, @ease_out_quint)}]
        }
        Group{
            mask: Rect{at: vec2(100, 330) size: tween(vec2(0, 190), vec2(1500, 190), 0.32, 1.22, @ease_in_out_cubic) feather: 60
                       x: tween(0, 1500, 3.8, 4.3, @ease_in_cubic)}
            layers: [
                Rect{at: vec2(100, 330) size: vec2(1700, 190) fill: in(@background)}
                Text{text: in(@line1) font: Font{family: "Inter" weight: 800} size: 150 tracking: -0.035 color: in(@ink)
                     at: vec2(160, 340) x: tween(40, 0, 0.2, 1.3, @ease_out_quint)}
            ]
        }
        // line 2: set in the accent, so its leading copy is ink
        Group{
            mask: Rect{at: vec2(100, 520) size: tween(vec2(0, 190), vec2(1500, 190), 0.35, 1.25, @ease_in_out_cubic) feather: 60
                       x: tween(0, 1500, 3.9, 4.4, @ease_in_cubic)}
            layers: [Text{text: in(@line2) font: Font{family: "Inter" weight: 800} size: 150 tracking: -0.035 color: in(@ink)
                          at: vec2(160, 530) x: tween(40, 0, 0.35, 1.45, @ease_out_quint)}]
        }
        Group{
            mask: Rect{at: vec2(100, 520) size: tween(vec2(0, 190), vec2(1500, 190), 0.47, 1.37, @ease_in_out_cubic) feather: 60
                       x: tween(0, 1500, 3.9, 4.4, @ease_in_cubic)}
            layers: [
                Rect{at: vec2(100, 520) size: vec2(1700, 190) fill: in(@background)}
                Text{text: in(@line2) font: Font{family: "Inter" weight: 800} size: 150 tracking: -0.035 color: in(@accent)
                     at: vec2(160, 530) x: tween(40, 0, 0.35, 1.45, @ease_out_quint)}
            ]
        }
    ]
}
