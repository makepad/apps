use mod.motion.*
// QUOTE CARD — editorial: warm paper, an oversized accent quote mark that
// settles with a slight overshoot, then the quote fades up word by word at
// reading pace (60 ms a word, soft 18 px rise, no bounce — the words are
// the point). The attribution arrives last behind a short rule.
// Why: the reveal runs at roughly reading speed, so the viewer reads along
// instead of waiting; paper and italic signal "someone said this".
Motion{
    label: "Quote card"
    brief: "An editorial quote on paper, revealed word by word, with attribution."
    tags: ["kinetic-type", "quote", "editorial", "testimonial"]
    duration: 7.0
    inputs: {
        quote: input(@text, "It turned a week of editing into an afternoon, and the result looked better than anything we had shipped before.", "Up to about 24 words")
        author: input(@text, "Ada Moreno", "Who said it")
        role: input(@text, "Head of Product, Lumen", "Their role")
        paper: input(@color, #f3efe6, "Ground")
        ink: input(@color, #1b1d22, "Type colour")
        accent: input(@color, #ff5c39, "Quote mark and rule")
    }
    layers: [
        Rect{size: vec2(1920, 1080) fill: in(@paper)}
        Group{
            opacity: tween(1, 0, 6.55, 7.0, @ease_in_cubic)
            layers: [
                Text{text: "“" font: Font{family: "IBM Plex Sans" weight: 600} size: 420 color: in(@accent)
                     at: vec2(160, 90)
                     scale: tween(0.5, 1.0, 0.1, 0.8, @ease_out_back) rotate: tween(-8, 0, 0.1, 0.8, @ease_out_back)
                     opacity: tween(0, 1, 0.1, 0.35, @ease_out_cubic)}
                Text{text: in(@quote) font: Font{family: "IBM Plex Sans" italic: true} size: 68 color: in(@ink)
                     line_height: 1.28 wrap: 1340 at: vec2(330, 290)
                     by: @word stagger: 0.06
                     opacity: tween(0, 1, 0.6, 1.2, @ease_out_cubic)
                     y: tween(18, 0, 0.6, 1.3, @ease_out_quint)}
                Rect{at: vec2(330, 800) size: vec2(72, 3) fill: in(@accent)
                     anchor: vec2(0, 0.5) scale: tween(vec2(0, 1), vec2(1, 1), 2.6, 3.2, @ease_out_expo)}
                Text{text: in(@author) font: Font{family: "Inter" weight: 700} size: 34 color: in(@ink) at: vec2(330, 826)
                     opacity: tween(0, 1, 2.8, 3.3, @ease_out_cubic) x: tween(-16, 0, 2.8, 3.5, @ease_out_quint)}
                Text{text: in(@role) font: Font{family: "Inter" weight: 500} size: 28 color: #6b6f77 at: vec2(330, 876)
                     opacity: tween(0, 1, 2.95, 3.45, @ease_out_cubic) x: tween(-16, 0, 2.95, 3.65, @ease_out_quint)}
            ]
        }
    ]
}
