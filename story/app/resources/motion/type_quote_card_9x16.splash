use mod.motion.*
// QUOTE CARD, 9:16 — the portrait cut of type_quote_card: the quote mark
// sits above the text rather than beside it, the quote runs 60 px on the
// safe column, and the attribution follows under a short rule.
// Why: a vertical stack reads top to bottom like a phone screen; the mark
// above the text works as a headline.
Motion{
    label: "Quote card 9:16"
    brief: "An editorial quote on paper, revealed word by word, with attribution; portrait."
    tags: ["kinetic-type", "quote", "editorial", "testimonial", "9:16"]
    size: vec2(1080, 1920) duration: 7.0
    inputs: {
        quote: input(@text, "It turned a week of editing into an afternoon, and the result looked better than anything we had shipped before.", "Up to about 24 words")
        author: input(@text, "Ada Moreno", "Who said it")
        role: input(@text, "Head of Product, Lumen", "Their role")
        paper: input(@color, #f3efe6, "Ground")
        ink: input(@color, #1b1d22, "Type colour")
        accent: input(@color, #ff5c39, "Quote mark and rule")
    }
    layers: [
        Rect{size: vec2(1080, 1920) fill: in(@paper)}
        Group{
            opacity: tween(1, 0, 6.55, 7.0, @ease_in_cubic)
            layers: [
                Text{text: "“" font: Font{family: "IBM Plex Sans" weight: 600} size: 360 color: in(@accent) at: vec2(80, 250)
                     scale: tween(0.5, 1.0, 0.1, 0.8, @ease_out_back) rotate: tween(-8, 0, 0.1, 0.8, @ease_out_back)
                     opacity: tween(0, 1, 0.1, 0.35, @ease_out_cubic)}
                Text{text: in(@quote) font: Font{family: "IBM Plex Sans" italic: true} size: 60 color: in(@ink)
                     line_height: 1.3 wrap: 840 at: vec2(100, 540)
                     by: @word stagger: 0.06
                     opacity: tween(0, 1, 0.6, 1.2, @ease_out_cubic)
                     y: tween(18, 0, 0.6, 1.3, @ease_out_quint)}
                Rect{at: vec2(100, 1050) size: vec2(72, 3) fill: in(@accent)
                     anchor: vec2(0, 0.5) scale: tween(vec2(0, 1), vec2(1, 1), 2.6, 3.2, @ease_out_expo)}
                Text{text: in(@author) font: Font{family: "Inter" weight: 700} size: 38 color: in(@ink) at: vec2(100, 1080)
                     opacity: tween(0, 1, 2.8, 3.3, @ease_out_cubic) x: tween(-16, 0, 2.8, 3.5, @ease_out_quint)}
                Text{text: in(@role) font: Font{family: "Inter" weight: 500} size: 30 color: #6b6f77 at: vec2(100, 1136)
                     opacity: tween(0, 1, 2.95, 3.45, @ease_out_cubic) x: tween(-16, 0, 2.95, 3.65, @ease_out_quint)}
            ]
        }
    ]
}
