use mod.motion.*
// SPLIT REVEAL — an accent rule opens from the centre and two lines slide
// out from behind it in opposite directions: a heavy line rising above, a
// light line dropping below. Both return behind the rule, which closes.
// Why: the rule is a physical edge the words hide behind, so the masks
// read as depth; 800-over-300 weight carries the hierarchy, not colour.
Motion{
    label: "Split reveal"
    brief: "Two lines slide out from behind a centre rule, one up, one down."
    tags: ["kinetic-type", "headline", "clean", "reveal", "mask"]
    duration: 4.6
    inputs: {
        top: input(@text, "Design the", "Upper line (heavy), about 16 characters")
        bottom: input(@text, "details", "Lower line (light), about 16 characters")
        ink: input(@color, #f4f7fa, "Type colour")
        accent: input(@color, #ff5c39, "Rule colour")
        background: input(@color, #0b0d12, "Ground")
    }
    layers: [
        Rect{size: vec2(1920, 1080) fill: in(@background)}
        // above the rule: the heavy line rises out of it
        Group{
            mask: Rect{size: vec2(1920, 537)}
            layers: [
                Text{text: in(@top) font: Font{family: "Inter" weight: 800} size: 136 tracking: -0.035 color: in(@ink)
                     at: vec2(960, 364) wrap: 1600 align: @center
                     y: keys([0.45, 170], [1.25, 0, @ease_out_expo], [3.75, 0], [4.2, 170, @ease_in_expo])}
            ]
        }
        // below the rule: the light line drops out of it
        Group{
            mask: Rect{at: vec2(0, 543) size: vec2(1920, 537)}
            layers: [
                Text{text: in(@bottom) font: Font{family: "Inter" weight: 300} size: 136 tracking: -0.02 color: in(@ink)
                     at: vec2(960, 552) wrap: 1600 align: @center
                     y: keys([0.55, -170], [1.35, 0, @ease_out_expo], [3.7, 0], [4.15, -170, @ease_in_expo])}
            ]
        }
        Rect{at: vec2(410, 537) size: vec2(1100, 6) radius: 3 fill: in(@accent)
             scale: keys([0.1, vec2(0, 1)], [0.8, vec2(1, 1), @ease_in_out_expo], [4.05, vec2(1, 1)], [4.5, vec2(0, 1), @ease_in_out_expo])}
    ]
}
