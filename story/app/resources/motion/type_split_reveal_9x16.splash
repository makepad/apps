use mod.motion.*
// SPLIT REVEAL, 9:16 — the portrait cut of type_split_reveal: the rule is
// the width of the safe column and sits at the safe area's centre line
// (y 760); the lines are 112 px so ~14 characters fit.
// Why: keeping the split on the safe centre (not the frame centre) keeps
// the lower line clear of captions and the platform's text.
Motion{
    label: "Split reveal 9:16"
    brief: "Two lines slide out from behind a centre rule, one up, one down; portrait."
    tags: ["kinetic-type", "headline", "clean", "reveal", "mask", "9:16"]
    size: vec2(1080, 1920) duration: 4.6
    inputs: {
        top: input(@text, "Design the", "Upper line (heavy), about 14 characters")
        bottom: input(@text, "details", "Lower line (light), about 14 characters")
        ink: input(@color, #f4f7fa, "Type colour")
        accent: input(@color, #ff5c39, "Rule colour")
        background: input(@color, #0b0d12, "Ground")
    }
    layers: [
        Rect{size: vec2(1080, 1920) fill: in(@background)}
        Group{
            mask: Rect{size: vec2(1080, 757)}
            layers: [Text{text: in(@top) font: Font{family: "Inter" weight: 800} size: 112 tracking: -0.035 color: in(@ink)
                          at: vec2(520, 609) wrap: 840 align: @center
                          y: keys([0.45, 150], [1.25, 0, @ease_out_expo], [3.75, 0], [4.2, 150, @ease_in_expo])}]
        }
        Group{
            mask: Rect{at: vec2(0, 763) size: vec2(1080, 757)}
            layers: [Text{text: in(@bottom) font: Font{family: "Inter" weight: 300} size: 112 tracking: -0.02 color: in(@ink)
                          at: vec2(520, 770) wrap: 840 align: @center
                          y: keys([0.55, -150], [1.35, 0, @ease_out_expo], [3.7, 0], [4.15, -150, @ease_in_expo])}]
        }
        Rect{at: vec2(140, 757) size: vec2(760, 6) radius: 3 fill: in(@accent)
             scale: keys([0.1, vec2(0, 1)], [0.8, vec2(1, 1), @ease_in_out_expo], [4.05, vec2(1, 1)], [4.5, vec2(0, 1), @ease_in_out_expo])}
    ]
}
