use mod.motion.*
// WORD PUNCH — a line lands one word at a time, each word slamming down
// from 135% with a blur that resolves on impact. The punch word gets its
// own beat: an accent block wipes open and the word hits it from 160%.
// Everything leaves as one block, up and out, faster than it came in.
// Why: scale-down + blur reads as weight arriving; one accent word gives
// the line a single point of emphasis.
Motion{
    label: "Word punch"
    brief: "A headline that lands word by word, ending on one word slammed onto an accent block."
    tags: ["kinetic-type", "headline", "bold", "punch"]
    duration: 4.0
    inputs: {
        lead: input(@text, "Ship it", "Two to four words that land first")
        punch: input(@text, "today.", "One word that lands on the accent block")
        ink: input(@color, #f4f7fa, "Type colour")
        accent: input(@color, #ff5c39, "Block colour")
        background: input(@color, #0b0d12, "Ground; use #00000000 to overlay footage")
    }
    layers: [
        Rect{size: vec2(1920, 1080) fill: in(@background)}
        Group{
            y: tween(0, -60, 3.55, 4.0, @ease_in_cubic)
            opacity: tween(1, 0, 3.6, 4.0, @ease_in_cubic)
            layers: [
                Text{text: in(@lead) font: Font{family: "Inter" weight: 800} size: 168 tracking: -0.035 color: in(@ink)
                     at: vec2(960, 349) wrap: 1600 align: @center
                     by: @word stagger: 0.2
                     scale: tween(1.35, 1.0, 0.15, 0.55, @ease_out_expo)
                     blur: tween(14, 0, 0.15, 0.45, @ease_out_cubic)
                     opacity: tween(0, 1, 0.15, 0.3, @ease_out_cubic)}
                Text{text: in(@punch) font: Font{family: "Inter" weight: 800} size: 168 tracking: -0.035 color: in(@background)
                     at: vec2(960, 549) wrap: 1600 align: @center
                     plate: in(@accent) plate_pad: vec2(36, 6) plate_radius: 6
                     plate_reveal: tween(0, 1, 0.62, 0.95, @ease_in_out_expo)
                     by: @word
                     scale: tween(1.6, 1.0, 0.82, 1.22, @ease_out_expo)
                     blur: tween(20, 0, 0.82, 1.1, @ease_out_cubic)
                     opacity: tween(0, 1, 0.82, 0.95, @ease_out_cubic)}
            ]
        }
    ]
}
